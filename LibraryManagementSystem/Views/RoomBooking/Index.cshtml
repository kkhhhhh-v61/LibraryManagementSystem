@{
    ViewBag.Title = "Room Manager";
}

@section Head {
    <link rel="stylesheet" href="/css/room.css" asp-append-version="true" />
}

<div class="dashboard-container">

    <div class="panel left-panel">
        <div class="panel-header">
            <div>
                <h2 class="panel-title">Room Categories</h2>
                <p style="margin:4px 0 0 0; font-size:0.85rem; color:#6b7280;">Manage availability and pricing</p>
            </div>
            <div style="font-size:0.85rem; background:#f3f4f6; padding:5px 12px; border-radius:20px; font-weight:600;">
                3 Records
            </div>
        </div>

        <div class="panel-body" style="padding: 0;">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th style="width:10%">ID</th>
                        <th style="width:20%">Name</th>
                        <th style="width:15%">Rate</th>
                        <th style="width:40%">Description</th>
                        <th style="width:15%">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><code>C01</code></td>
                        <td><strong>Discussion Room</strong></td>
                        <td>RM 5.00</td>
                        <td style="color:#666;">Standard room for 4-6 pax with whiteboard.</td>
                        <td><a href="#" class="btn-action">Details</a></td>
                    </tr>
                    <tr>
                        <td><code>C02</code></td>
                        <td><strong>Music Room</strong></td>
                        <td>RM 15.00</td>
                        <td style="color:#666;">Soundproof room equipped with piano.</td>
                        <td><a href="#" class="btn-action">Details</a></td>
                    </tr>
                    <tr>
                        <td><code>C03</code></td>
                        <td><strong>Conference Hall</strong></td>
                        <td>RM 50.00</td>
                        <td style="color:#666;">Large hall, projector & PA system.</td>
                        <td><a href="#" class="btn-action">Details</a></td>
                    </tr>
                    <tr>
                        <td><code>C04</code></td>
                        <td><strong>Study Pod</strong></td>
                        <td>RM 2.00</td>
                        <td style="color:#666;">Individual quiet zone.</td>
                        <td><a href="#" class="btn-action">Details</a></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>


    <div class="panel right-panel">
        <div class="panel-header">
            <h2 class="panel-title">Quick Actions</h2>
        </div>

        <div class="panel-body">

            <div class="form-section">
                <div class="section-label">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
                    New Category
                </div>

                <form asp-action="Create" method="post">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Category ID</label>
                            <input type="text" name="Id" class="form-input" placeholder="e.g. C05">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Name</label>
                            <input type="text" name="Name" class="form-input" placeholder="Gaming Room">
                        </div>
                        <div class="form-group full-width">
                            <label class="form-label">Hourly Rate (RM)</label>
                            <input type="number" name="HourlyRate" class="form-input" placeholder="0.00">
                        </div>
                        <div class="form-group full-width">
                            <label class="form-label">Description</label>
                            <textarea name="Description" class="form-input" rows="2" style="resize:none;"></textarea>
                        </div>
                    </div>
                    <button type="submit" class="btn-save">Save Category</button>
                </form>
            </div>

            <div class="form-section">
                <div class="section-label" style="color:#10b981;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M9 3v18" /></svg>
                    New Room
                </div>

                <form asp-action="CreateRoom" method="post">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Room ID</label>
                            <input type="text" name="RoomId" class="form-input" placeholder="R-202">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Capacity</label>
                            <input type="number" name="Capacity" class="form-input" placeholder="4">
                        </div>
                        <div class="form-group full-width">
                            <label class="form-label">Assign Category</label>
                            <select name="CategoryId" class="form-input">
                                <option>Discussion Room</option>
                                <option>Music Room</option>
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn-save" style="background-color:#10b981;">Save Room</button>
                </form>
            </div>

        </div>
    </div>

</div>