@model List<Loan>

@if (Model == null || !Model.Any())
{
    <div class="empty-state">
        <p class="empty-state__text">No reservations found for this user.</p>
    </div>
}
else
{
    <form id="pickupForm" onsubmit="submitPickup(event)">
        <table class="table">
            <thead>
                <tr class="table__header">
                    <th class="table__cell table__cell--checkbox">
                        <input class="checkbox-styled" type="checkbox" id="selectAllPickup" checked onclick="toggleAllPickup(this)" />
                    </th>
                    <th class="table__cell">Book Title</th>
                    <th class="table__cell">Copy Barcode</th>
                    <th class="table__cell">Reserved Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model)
                {
                    <tr class="table__row">
                        <td class="table__cell table__cell--checkbox">
                            <input class="checkbox-styled pickup-check" type="checkbox" name="loanIds" value="@loan.Id" checked />
                        </td>
                        <td class="table__cell table__cell--main">@loan.Copy.Book.Title</td>
                        <td class="table__cell font-mono">@loan.Copy.Barcode</td>
                        <td class="table__cell">@loan.LoanDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
        <div style="margin-top: var(--spacing-md); display: flex; justify-content: flex-end;">
            <button type="submit" class="form__button form__button--submit">Confirm Pickup</button>
        </div>
    </form>
}