@model ReviewHistoryVM

<table class="table">
    <thead>
        <tr class="table__header">
            <th class="table__cell sortable-header @(Model.SortColumn == "Book" ? "active" : "")" data-sort="Book" data-order="@(Model.SortColumn == "Book" ? Model.SortOrder : "asc")" style="min-width: 350px;">
                Book
                @if (Model.SortColumn == "Book")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "Rating" ? "active" : "")" data-sort="Rating" data-order="@(Model.SortColumn == "Rating" ? Model.SortOrder : "asc")" style="width: 160px;">
                Rating
                @if (Model.SortColumn == "Rating")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell" style="min-width: 300px;">Comment</th>
            <th class="table__cell sortable-header @(Model.SortColumn == "Date" ? "active" : "")" data-sort="Date" data-order="@(Model.SortColumn == "Date" ? Model.SortOrder : "asc")" style="width: 120px;">
                Date
                @if (Model.SortColumn == "Date")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell" style="width: 100px; text-align: center;">Action</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Loans.Any())
        {
            <tr class="table__row">
                <td class="table__cell" colspan="5" style="text-align:center; color: var(--color-gray-500);">
                    No reviewable loans found.
                </td>
            </tr>
        }
        else
        {
            @foreach (var loan in Model.Loans)
            {
                <tr class="table__row">
                    <td class="table__cell">
                        <div style="display: flex; align-items: center; gap: 1rem;">
                            <img src="@(string.IsNullOrEmpty(loan.Copy.Book.ImageURL) ? "/images/assets/no-cover.jpg" : $"/images/books/{loan.Copy.Book.ImageURL}")" 
                                 class="book-thumbnail" 
                                 alt="@loan.Copy.Book.Title" />
                            <div class="book-info">
                                <a href="@Url.Action("BookDetails", "Book", new { id = loan.Copy.BookId })" class="book-title" style="text-decoration: none; color: inherit;">@loan.Copy.Book.Title</a>
                                <span class="book-author" style="font-size: 0.85rem; color: var(--color-gray-500);">@string.Join(", ", loan.Copy.Book.Authors.Select(a => a.Name))</span>
                            </div>
                        </div>
                    </td>
                    <td class="table__cell">
                        @if (loan.Review != null)
                        {
                            <div style="color: var(--color-warning); font-size: 0.9rem;">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fa-solid fa-star @(i <= loan.Review.Rating ? "star-filled" : "star-empty")" style="@(i > loan.Review.Rating ? "color: var(--color-gray-300);" : "")"></i>
                                }
                            </div>
                        }
                        else
                        {
                            <span style="color: var(--color-gray-400);">-</span>
                        }
                    </td>
                    <td class="table__cell">
                        @if (loan.Review != null)
                        {
                            if (!string.IsNullOrEmpty(loan.Review.Comment))
                            {
                                <span style="color: var(--color-gray-700);">@loan.Review.Comment</span>
                            }
                            else
                            {
                                <span style="color: var(--color-gray-400); font-style: italic;">No comment provided</span>
                            }
                        }
                        else
                        {
                            <span style="color: var(--color-gray-400);">-</span>
                        }
                    </td>
                    <td class="table__cell">
                        @if (loan.Review != null)
                        {
                            <span>@loan.Review.ReviewDate.ToString("yyyy-MM-dd")</span>
                        }
                        else
                        {
                            <span style="color: var(--color-gray-500); font-size: 0.85rem;">Returned: @(loan.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")</span>
                        }
                    </td>
                    <td class="table__cell" style="text-align: center;">
                        <div class="table__actions">
                            <a href="@Url.Action("BookDetails", "Book", new { id = loan.Copy.BookId })#reviewsContainer" class="action__button" title="View Reviews">
                                <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#0080ff">
                                    <path d="M480-320q75 0 127.5-52.5T660-500q0-75-52.5-127.5T480-680q-75 0-127.5 52.5T300-500q0 75 52.5 127.5T480-320Zm0-72q-45 0-76.5-31.5T372-500q0-45 31.5-76.5T480-608q45 0 76.5 31.5T588-500q0 45-31.5 76.5T480-392Zm0 192q-146 0-266-81.5T40-500q54-137 174-218.5T480-800q146 0 266 81.5T920-500q-54 137-174 218.5T480-200Z"/>
                                </svg>
                            </a>
                            @if (loan.Review == null)
                            {
                                <button class="action__button action__button--edit js-review-trigger" data-id="@loan.Id" data-title="@loan.Copy.Book.Title" data-image="@(string.IsNullOrEmpty(loan.Copy.Book.ImageURL) ? "/images/assets/no-cover.jpg" : $"/images/books/{loan.Copy.Book.ImageURL}")" title="Write Review" type="button">
                                    <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="m354-287 126-76 126 77-33-144 111-96-146-13-58-136-58 135-146 13 111 97-33 143ZM233-120l65-281L80-590l288-25 112-265 112 265 288 25-218 189 65 281-247-149-247 149Z"/></svg>
                                </button>
                            }
                            else
                            {
                                <button class="action__button js-review-trigger" data-id="@loan.Id" data-title="@loan.Copy.Book.Title" data-image="@(string.IsNullOrEmpty(loan.Copy.Book.ImageURL) ? "/images/assets/no-cover.jpg" : $"/images/books/{loan.Copy.Book.ImageURL}")" data-rating="@loan.Review.Rating" data-comment="@loan.Review.Comment" title="Edit Review" type="button">
                                    <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#22c55e"><path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"/></svg>
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <button class="pagination__link" type="button" data-page="@(Model.CurrentPage - 1)">Previous</button>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <button class="pagination__link @(i == Model.CurrentPage ? "pagination__link--active" : "")" type="button" data-page="@i">@i</button>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <button class="pagination__link" type="button" data-page="@(Model.CurrentPage + 1)">Next</button>
        }
    </div>
}