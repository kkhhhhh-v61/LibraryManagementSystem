@model LoanManagementVM

<table class="table">
    <thead>
        <tr class="table__header">
            @if (User.IsInRole("ADMIN"))
            {
                <th class="table__cell table__cell--checkbox">
                    <input class="checkbox-styled" id="selectAll" type="checkbox" />
                </th>
            }
            <th class="table__cell sortable-header @(Model.SortColumn == "Id" ? "active" : "")" data-sort="Id" data-order="@(Model.SortColumn == "Id" ? Model.SortOrder : "asc")" style="width: 80px;">
                ID
                @if (Model.SortColumn == "Id")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "User" ? "active" : "")" data-sort="User" data-order="@(Model.SortColumn == "User" ? Model.SortOrder : "asc")">
                User
                @if (Model.SortColumn == "User")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "Book" ? "active" : "")" data-sort="Book" data-order="@(Model.SortColumn == "Book" ? Model.SortOrder : "asc")" style="min-width: 300px;">
                Book
                @if (Model.SortColumn == "Book")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "LoanDate" ? "active" : "")" data-sort="LoanDate" data-order="@(Model.SortColumn == "LoanDate" ? Model.SortOrder : "asc")" style="width: 150px;">
                Loaned On
                @if (Model.SortColumn == "LoanDate")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "DueDate" ? "active" : "")" data-sort="DueDate" data-order="@(Model.SortColumn == "DueDate" ? Model.SortOrder : "asc")" style="width: 250px;">
                Next Date
                @if (Model.SortColumn == "DueDate")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "Status" ? "active" : "")" data-sort="Status" data-order="@(Model.SortColumn == "Status" ? Model.SortOrder : "asc")" style="width: 200px;">
                Status
                @if (Model.SortColumn == "Status")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            @if (User.IsInRole("ADMIN"))
            {
                <th class="table__cell table__cell--actions" style="width: 100px; text-align: center;">Actions</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (!Model.ExistingLoans.Any())
        {
            <tr class="table__row">
                <td class="table__cell" colspan="@(User.IsInRole("ADMIN") ? "8" : "6")" style="text-align:center; color: var(--color-gray-500);">
                    No loans found.
                </td>
            </tr>
        }
        else 
        {
            @foreach (var loan in Model.ExistingLoans)
            {
                <tr class="table__row">
                    @if (User.IsInRole("ADMIN"))
                    {
                        <td class="table__cell table__cell--checkbox">
                            <input class="row-checkbox checkbox-styled" type="checkbox" name="ids" value="@loan.Id" data-name="@loan.Id" />
                        </td>
                    }
                    <td class="table__cell table__cell--id">@loan.Id</td>
                    <td class="table__cell">
                        <div style="display: flex; flex-direction: column;">
                            <span style="font-weight: 600; color: var(--color-gray-900);">@loan.User.Username</span>
                            <span style="font-size: 0.8rem; color: var(--color-gray-500);">@loan.UserId</span>
                        </div>
                    </td>
                    <td class="table__cell">
                        <div style="display: flex; flex-direction: column;">
                            <span style="font-weight: 600; color: var(--color-gray-900);">@loan.Copy.Book.Title</span>
                            <span style="font-size: 0.8rem; color: var(--color-gray-500); font-family: monospace;">@loan.Copy.Id</span>
                        </div>
                    </td>
                    <td class="table__cell">@loan.LoanDate.ToString("yyyy-MM-dd")</td>
                    <td class="table__cell">
                        @switch (loan.Status)
                        {
                            case Loan.LoanStatus.RESERVED:
                                <span style="color: var(--color-primary-base); font-weight: 500;">
                                    Pickup by @loan.PickupDue.ToString("yyyy-MM-dd")
                                </span>
                                break;
                            case Loan.LoanStatus.IN_LOAN:
                                <span style="color: var(--color-gray-700);">
                                    Return by @loan.LoanDue.ToString("yyyy-MM-dd")
                                </span>
                                break;
                            case Loan.LoanStatus.OVERDUE:
                                <span style="color: var(--color-error); font-weight: 600;">
                                    Due was @loan.LoanDue.ToString("yyyy-MM-dd")
                                </span>
                                break;
                            case Loan.LoanStatus.EXPIRED:
                                <span style="color: var(--color-gray-500);">
                                    Missed pickup
                                </span>
                                break;
                            case Loan.LoanStatus.RETURNED:
                                if (loan.ReturnDate > loan.LoanDue)
                                {
                                    <span style="color: var(--color-error); font-weight: 600;">
                                        Returned on @(loan.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")
                                    </span>
                                }
                                else
                                {
                                    <span style="color: var(--color-gray-500);">
                                        Returned on @(loan.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")
                                    </span>
                                }
                                break;
                            default:
                                <span>
                                    -
                                </span>
                                break;
                        }
                    </td>
                    <td class="table__cell">
                        @{
                            var statusClass = loan.Status switch
                            {
                                Loan.LoanStatus.IN_LOAN => "status-available",
                                Loan.LoanStatus.OVERDUE => "status-unavailable",
                                Loan.LoanStatus.RESERVED => "status-reserved",
                                _ => "status-neutral"
                            };
                        }
                        <span class="status-badge @statusClass" style="font-size: var(--text-md); padding: 4px 12px;">
                            @(loan.Status switch
                            {
                                Loan.LoanStatus.RESERVED => "Waiting for Pickup",
                                Loan.LoanStatus.IN_LOAN => "In Loan",
                                _ => System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(loan.Status.ToString().ToLower())
                            })
                        </span>
                    </td>
                    @if (User.IsInRole("ADMIN"))
                    {
                        <td class="table__cell table__cell--actions">
                            <div class="table__actions">
                                <button class="action__button action__button--edit js-edit-loan" 
                                        data-id="@loan.Id" 
                                        data-loandate="@loan.LoanDate.ToString("yyyy-MM-dd")"
                                        data-loandue="@loan.LoanDue.ToString("yyyy-MM-dd")"
                                        data-pickupdue="@loan.PickupDue.ToString("yyyy-MM-dd")"
                                        data-pickupdate="@(loan.PickupDate?.ToString("yyyy-MM-dd") ?? "")"
                                        data-returndate="@(loan.ReturnDate?.ToString("yyyy-MM-dd") ?? "")"
                                        title="Edit"
                                        type="button">
                                    <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000">
                                        <path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"/>
                                    </svg>
                                </button>
                                <button class="action__button action__button--delete js-delete-trigger" 
                                        data-id="@loan.Id" 
                                        data-name="@loan.Id" 
                                        title="Delete"
                                        type="button">
                                    <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000">
                                        <path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    }
                </tr>
            }
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <button class="pagination__link" type="button" data-page="@(Model.CurrentPage - 1)">Previous</button>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <button class="pagination__link @(i == Model.CurrentPage ? "pagination__link--active" : "")" type="button" data-page="@i">@i</button>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <button class="pagination__link" type="button" data-page="@(Model.CurrentPage + 1)">Next</button>
        }
    </div>
}