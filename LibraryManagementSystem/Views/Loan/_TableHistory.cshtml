@model LoanHistoryVM

<table class="table">
    <thead>
        <tr class="table__header">
            <th class="table__cell table__cell--checkbox">
                <input class="checkbox-styled" id="selectAll" type="checkbox" />
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "Book" ? "active" : "")" data-sort="Book" data-order="@(Model.SortColumn == "Book" ? Model.SortOrder : "asc")" style="min-width: 300px;">
                Book
                @if (Model.SortColumn == "Book")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "LoanDate" ? "active" : "")" data-sort="LoanDate" data-order="@(Model.SortColumn == "LoanDate" ? Model.SortOrder : "asc")" style="width: 160px;">
                Loaned On
                @if (Model.SortColumn == "LoanDate")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "DueDate" ? "active" : "")" data-sort="DueDate" data-order="@(Model.SortColumn == "DueDate" ? Model.SortOrder : "asc")" style="width: 250px;">
                Next Date
                @if (Model.SortColumn == "DueDate")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "Status" ? "active" : "")" data-sort="Status" data-order="@(Model.SortColumn == "Status" ? Model.SortOrder : "asc")" style="width: 200px;">
                Status
                @if (Model.SortColumn == "Status")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell table__cell--actions" style="width: 100px; text-align: center;">Action</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Loans.Any())
        {
            <tr class="table__row">
                <td class="table__cell" colspan="6" style="text-align:center; color: var(--color-gray-500);">
                    No loans found.
                </td>
            </tr>
        }
        else 
        {
            @foreach (var loan in Model.Loans)
            {
                <tr class="table__row">
                    <td class="table__cell table__cell--checkbox">
                        @if (loan.Status == Loan.LoanStatus.RESERVED || loan.Status == Loan.LoanStatus.IN_LOAN || loan.Status == Loan.LoanStatus.OVERDUE)
                        {
                            <input class="row-checkbox checkbox-styled" type="checkbox" name="ids" value="@loan.Id" data-name="@loan.Copy.Book.Title" data-status="@loan.Status" />
                        }
                        else
                        {
                            <input class="checkbox-styled" type="checkbox" disabled style="opacity: 0.3; cursor: default;" />
                        }
                    </td>
                    <td class="table__cell">
                        <a href="@Url.Action("BookDetails", "Book", new { id = loan.Copy.BookId })" style="text-decoration: none; color: inherit; font-weight: 600;">
                            @loan.Copy.Book.Title
                        </a>
                    </td>
                    <td class="table__cell">@loan.LoanDate.ToString("yyyy-MM-dd")</td>
                    <td class="table__cell">
                        @switch (loan.Status)
                        {
                            case Loan.LoanStatus.RESERVED:
                                <span style="color: var(--color-primary-base); font-weight: 500;">Pickup by @loan.PickupDue.ToString("yyyy-MM-dd")</span>
                                break;
                            case Loan.LoanStatus.IN_LOAN:
                                <span style="color: var(--color-gray-700);">Return by @loan.LoanDue.ToString("yyyy-MM-dd")</span>
                                break;
                            case Loan.LoanStatus.OVERDUE:
                                <span style="color: var(--color-error); font-weight: 600;">Due was @loan.LoanDue.ToString("yyyy-MM-dd")</span>
                                break;
                            case Loan.LoanStatus.EXPIRED:
                                <span style="color: var(--color-gray-500);">Missed pickup</span>
                                break;
                            case Loan.LoanStatus.RETURNED:
                                if (loan.ReturnDate > loan.LoanDue) { <span style="color: var(--color-error); font-weight: 600;">Returned on @(loan.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")</span> }
                                else { <span style="color: var(--color-gray-500);">Returned on @(loan.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")</span> }
                                break;
                            default:
                                <span>-</span>
                                break;
                        }
                    </td>
                    <td class="table__cell">
                        @{
                            var statusClass = loan.Status switch
                            {
                                Loan.LoanStatus.IN_LOAN => "status-available",
                                Loan.LoanStatus.OVERDUE => "status-unavailable",
                                Loan.LoanStatus.RESERVED => "status-reserved",
                                _ => "status-neutral"
                            };
                        }
                        <span class="status-badge @statusClass" style="font-size: var(--text-md); padding: 4px 12px;">
                            @(loan.Status switch { Loan.LoanStatus.RESERVED => "Waiting for Pickup", Loan.LoanStatus.IN_LOAN => "In Loan", _ => System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(loan.Status.ToString().ToLower()) })
                        </span>
                    </td>
                    <td class="table__cell table__cell--actions">
                        <div class="table__actions">
                            <a href="@Url.Action("Confirmation", "Loan", new { id = loan.Id })" class="action__button" title="View Slip">
                                <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000">
                                    <path d="M320-240h320v-80H320v80Zm0-160h320v-80H320v80ZM240-80q-33 0-56.5-23.5T160-160v-640q0-33 23.5-56.5T240-880h320l240 240v480q0 33-23.5 56.5T720-80H240Zm280-520v-200H240v640h480v-440H520ZM240-800v200-200 640-640Z"/>
                                </svg>
                            </a>
                            @if (loan.Status == Loan.LoanStatus.RESERVED)
                            {
                                <button class="action__button action__button--delete js-delete-trigger"
                                        data-id="@loan.Id"
                                        data-name="@loan.Copy.Book.Title"
                                        title="Cancel Loan"
                                        type="button">
                                    <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000">
                                        <path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/>
                                    </svg>
                                </button>
                            }
                            @if (loan.Status == Loan.LoanStatus.RETURNED && loan.Review == null)
                            {
                                <button class="action__button js-review-trigger" 
                                        data-id="@loan.Id" 
                                        data-title="@loan.Copy.Book.Title"
                                        data-image="@(string.IsNullOrEmpty(loan.Copy.Book.ImageURL) ? "/images/assets/no-cover.jpg" : $"/images/books/{loan.Copy.Book.ImageURL}")"
                                        title="Rate & Review"
                                        type="button">
                                    <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#eab308">
                                        <path d="m354-287 126-76 126 77-33-144 111-96-146-13-58-136-58 135-146 13 111 97-33 143ZM233-120l65-281L80-590l288-25 112-265 112 265 288 25-218 189 65 281-247-149-247 149Z"/>
                                    </svg>
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @if (Model.CurrentPage > 1) { <button class="pagination__link" type="button" data-page="@(Model.CurrentPage - 1)">Previous</button> }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <button class="pagination__link @(i == Model.CurrentPage ? "pagination__link--active" : "")" type="button" data-page="@i">@i</button>
        }

        @if (Model.CurrentPage < Model.TotalPages) { <button class="pagination__link" type="button" data-page="@(Model.CurrentPage + 1)">Next</button> }
    </div>
}