@model ReviewHistoryVM

@{
    ViewBag.Title = "My Reviews";
}

@section head {
    <link rel="stylesheet" href="/css/book.css" asp-append-version="true" />
}

<div class="manage__content">
    <div class="manage__panel">
        <div class="panel__header">
            <div class="header__start">
                <h2 class="panel__title">My Reviews</h2>
            </div>
        </div>

        <div class="panel__table-container">
            <table class="table">
                <thead>
                    <tr class="table__header">
                        <th class="table__cell" style="min-width: 350px;">Book</th>
                        <th class="table__cell" style="width: 160px;">Rating</th>
                        <th class="table__cell" style="min-width: 300px;">Comment</th>
                        <th class="table__cell" style="width: 120px;">Date</th>
                        <th class="table__cell" style="width: 100px; text-align: center;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Loans.Any())
                    {
                        <tr class="table__row">
                            <td class="table__cell" colspan="5" style="text-align:center; color: var(--color-gray-500);">
                                No reviewable loans found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var loan in Model.Loans)
                        {
                            <tr class="table__row">
                                <td class="table__cell">
                                    <a href="@Url.Action("BookDetails", "Book", new { id = loan.Copy.BookId })" style="text-decoration: none; color: inherit; font-weight: 600;">
                                        @loan.Copy.Book.Title
                                    </a>
                                </td>
                                <td class="table__cell">
                                    @if (loan.Review != null)
                                    {
                                        <div style="color: var(--color-warning); font-size: 0.9rem;">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fa-solid fa-star @(i <= loan.Review.Rating ? "star-filled" : "star-empty")" style="@(i > loan.Review.Rating ? "color: var(--color-gray-300);" : "")"></i>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="color: var(--color-gray-400);">-</span>
                                    }
                                </td>
                                <td class="table__cell">
                                    @if (loan.Review != null)
                                    {
                                        if (!string.IsNullOrEmpty(loan.Review.Comment))
                                        {
                                            <span style="color: var(--color-gray-700);">@loan.Review.Comment</span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--color-gray-400); font-style: italic;">No comment provided</span>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color: var(--color-gray-400);">-</span>
                                    }
                                </td>
                                <td class="table__cell">
                                    @if (loan.Review != null)
                                    {
                                        <span>@loan.Review.ReviewDate.ToString("yyyy-MM-dd")</span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--color-gray-500); font-size: 0.85rem;">Returned: @(loan.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")</span>
                                    }
                                </td>
                                <td class="table__cell" style="text-align: center;">
                                    <div class="table__actions">
                                        <a href="@Url.Action("BookDetails", "Book", new { id = loan.Copy.BookId })#reviewsContainer" class="action__button" title="View Reviews">
                                            <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#0080ff">
                                                <path d="M480-320q75 0 127.5-52.5T660-500q0-75-52.5-127.5T480-680q-75 0-127.5 52.5T300-500q0 75 52.5 127.5T480-320Zm0-72q-45 0-76.5-31.5T372-500q0-45 31.5-76.5T480-608q45 0 76.5 31.5T588-500q0 45-31.5 76.5T480-392Zm0 192q-146 0-266-81.5T40-500q54-137 174-218.5T480-800q146 0 266 81.5T920-500q-54 137-174 218.5T480-200Z"/>
                                            </svg>
                                        </a>
                                        @if (loan.Review == null)
                                        {
                                            <button class="action__button js-review-trigger"
                                                    data-id="@loan.Id"
                                                    data-title="@loan.Copy.Book.Title"
                                                    data-image="@(string.IsNullOrEmpty(loan.Copy.Book.ImageURL) ? "/images/assets/no-cover.jpg" : $"/images/books/{loan.Copy.Book.ImageURL}")"
                                                    title="Write Review"
                                                    type="button">
                                                <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#eab308">
                                                    <path d="m354-287 126-76 126 77-33-144 111-96-146-13-58-136-58 135-146 13 111 97-33 143ZM233-120l65-281L80-590l288-25 112-265 112 265 288 25-218 189 65 281-247-149-247 149Z"/>
                                                </svg>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="action__button js-review-trigger"
                                                    data-id="@loan.Id"
                                                    data-title="@loan.Copy.Book.Title"
                                                    data-image="@(string.IsNullOrEmpty(loan.Copy.Book.ImageURL) ? "/images/assets/no-cover.jpg" : $"/images/books/{loan.Copy.Book.ImageURL}")"
                                                    data-rating="@loan.Review.Rating"
                                                    data-comment="@loan.Review.Comment"
                                                    title="Edit Review"
                                                    type="button">
                                                <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#22c55e">
                                                    <path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"/>
                                                </svg>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="pagination">
                @if (Model.CurrentPage > 1) { <a href="@Url.Action("Reviews", new { page = Model.CurrentPage - 1 })" class="pagination__link">Previous</a> }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a href="@Url.Action("Reviews", new { page = i })" class="pagination__link @(i == Model.CurrentPage ? "pagination__link--active" : "")">@i</a>
                }

                @if (Model.CurrentPage < Model.TotalPages) { <a href="@Url.Action("Reviews", new { page = Model.CurrentPage + 1 })" class="pagination__link">Next</a> }
            </div>
        }
    </div>
</div>

<div class="modal" id="modal-review">
    <div class="modal__container" style="max-width: 650px;">
        <div class="modal__header">
            <h2 class="modal__title" id="reviewModalTitle">Rate & Review</h2>
            <button class="modal__close js-close-modal" type="button">
                <svg class="close__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>
            </button>
        </div>
        <form class="modal__form" id="reviewForm">
            <div class="modal__content" style="display: flex; gap: 1.5rem;">
                <div class="review-book-info">
                    <img id="reviewBookCover" src="" alt="Book Cover" class="review-book-cover" />
                    <h3 id="reviewBookTitle" class="review-book-title"></h3>
                </div>
                <div class="review-form-fields">
                    <input type="hidden" name="loanId" id="reviewLoanId" />
                    <div class="form__field" style="align-items: center;">
                        <label class="field__label" style="font-size: 1rem; margin-bottom: 0.5rem;">Your Rating</label>
                        <div class="star-rating">
                            <input type="radio" id="star5" name="rating" value="5" required /><label for="star5" title="5 stars"></label>
                            <input type="radio" id="star4" name="rating" value="4" /><label for="star4" title="4 stars"></label>
                            <input type="radio" id="star3" name="rating" value="3" /><label for="star3" title="3 stars"></label>
                            <input type="radio" id="star2" name="rating" value="2" /><label for="star2" title="2 stars"></label>
                            <input type="radio" id="star1" name="rating" value="1" /><label for="star1" title="1 star"></label>
                        </div>
                        <span class="field__error" id="ratingError" style="display: none; text-align: center; margin-top: 0.5rem;">Please select a rating.</span>
                    </div>

                    <div class="form__field">
                        <label class="field__label" style="font-size: 1rem;">Comment (Optional)</label>
                        <textarea class="field__input input--textarea" name="comment" id="reviewComment" placeholder="Share your thoughts about the book..." style="height: 120px;"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal__footer">
                <button class="form__button form__button--cancel js-close-modal" type="button">Cancel</button>
                <button class="form__button form__button--submit" id="submitReviewBtn" type="submit">Submit Review</button>
            </div>
        </form>
    </div>
</div>

@section foot {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const reviewModal = document.getElementById("modal-review");
            const reviewForm = document.getElementById("reviewForm");
            const submitBtn = document.getElementById("submitReviewBtn");
            const ratingError = document.getElementById("ratingError");
            const modalTitle = document.getElementById("reviewModalTitle");
            
            // Open Modal
            document.body.addEventListener("click", (e) => {
                const btn = e.target.closest(".js-review-trigger");
                if (btn) {
                    document.getElementById("reviewLoanId").value = btn.dataset.id;
                    document.getElementById("reviewBookTitle").textContent = btn.dataset.title; // Title
                    document.getElementById("reviewBookCover").src = btn.dataset.image; // Image
                    
                    // Reset form
                    reviewForm.reset();
                    ratingError.style.display = "none";

                    // Check if editing
                    if (btn.dataset.rating) {
                        modalTitle.textContent = "Edit Review";
                        const rating = btn.dataset.rating;
                        const comment = btn.dataset.comment;
                        
                        const radio = reviewForm.querySelector(`input[name="rating"][value="${rating}"]`);
                        if (radio) radio.checked = true;
                        
                        document.getElementById("reviewComment").value = comment || "";
                    } else {
                        modalTitle.textContent = "Rate & Review";
                    }

                    reviewModal.classList.add("active");
                }
            });

            // Close Modal
            reviewModal.querySelectorAll(".js-close-modal").forEach(btn => {
                btn.addEventListener("click", () => reviewModal.classList.remove("active"));
            });

            // Submit Review
            reviewForm.addEventListener("submit", (e) => {
                e.preventDefault();
                const rating = reviewForm.querySelector('input[name="rating"]:checked');
                if (!rating) {
                    ratingError.style.display = "block";
                    return;
                } else {
                    ratingError.style.display = "none";
                }

                const formData = new FormData(reviewForm);
                const originalBtnText = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Submitting...`;
                
                fetch("/Book/SubmitReview", { method: "POST", body: formData })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            window.showToast(data.message, "success");
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            window.showToast(data.message, "error");
                        }
                    })
                    .catch(err => console.error(err))
                    .finally(() => {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalBtnText;
                    });
            });
        });
    </script>
}