@{
    ViewBag.Title = "Category Management";
}

<div class="page-header">
    <h2>Room Categories</h2>
    <a href="/RoomCategories/Create" class="btn btn-primary">
        <span>+</span> Add New Category
    </a>
</div>

<div class="card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Category Name</th>
                <th>Hourly Rate (RM)</th>
                <th>Description</th>
                <th>Rooms Count</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><strong>Discussion Room (Standard)</strong></td>
                <td>5.00</td>
                <td>Suitable for 4-6 pax, standard whiteboard.</td>
                <td>4</td>
                <td>
                    <a href="#" class="btn btn-outline" style="padding: 4px 8px;">Edit</a>
                    <button class="btn btn-outline" style="padding: 4px 8px; color: red;">Delete</button>
                </td>
            </tr>
            <tr>
                <td><strong>Conference Room (Premium)</strong></td>
                <td>20.00</td>
                <td>Capacity 15+, Projector, AC, Sound System.</td>
                <td>1</td>
                <td>
                    <a href="#" class="btn btn-outline" style="padding: 4px 8px;">Edit</a>
                    <button class="btn btn-outline" style="padding: 4px 8px; color: red;">Delete</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<div class="card">
    <h3 style="margin-bottom: var(--fixed-space-md); font-size: var(--fixed-font-size-md);">Quick Add Category</h3>
    <form>
        <div class="form-grid">
            <div class="form-group">
                <label>Category Name</label>
                <input type="text" class="form-control" placeholder="e.g. Music Room">
            </div>
            <div class="form-group">
                <label>Hourly Rate</label>
                <input type="number" class="form-control" placeholder="0.00">
            </div>
            <div class="form-group" style="grid-column: span 2;">
                <label>Description</label>
                <textarea class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div style="margin-top: var(--fixed-space-sm); text-align: right;">
            <button type="submit" class="btn btn-primary">Save Category</button>
        </div>
    </form>
</div>