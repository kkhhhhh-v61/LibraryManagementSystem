@model AuthorManagementVM

@{
    ViewBag.Title = "Manage Author";

    // Calculate Stats
    var totalAuthors = Model.ExistingAuthors.Count;
    var unusedAuthors = Model.ExistingAuthors.Count(a => a.Books.Count == 0);
    var topAuthor = Model.ExistingAuthors.OrderByDescending(a => a.Books.Count).FirstOrDefault();
}

@section head {
    <link rel="stylesheet" href="/css/book.css" asp-append-version="true" />
}

<form class="manage__content" asp-action="BatchDeleteAuthor" method="post" id="batchForm">
    
    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-card">
            <span class="stat-card__title">Total Authors</span>
            <span class="stat-card__value">@totalAuthors</span>
            <span class="stat-card__desc">Registered authors</span>
        </div>
        <div class="stat-card">
            <span class="stat-card__title">Unused Authors</span>
            <span class="stat-card__value">@unusedAuthors</span>
            <span class="stat-card__desc">No books assigned</span>
        </div>
        <div class="stat-card">
            <span class="stat-card__title">Top Author</span>
            <span class="stat-card__value">@(topAuthor?.Name ?? "-")</span>
            <span class="stat-card__desc">@(topAuthor?.Books.Count ?? 0) books</span>
        </div>
    </div>

    <!-- Main Panel -->
    <div class="manage__panel">
        <div class="panel__header">
            <div class="header__start">
                <h2 class="panel__title">All Authors</h2>
                <div class="search__wrapper">
                    <svg class="search__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#999">
                        <path d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z" />
                    </svg>
                    <input class="search__input--header" id="nameSearchInput" type="text" placeholder="Search authors..." autocomplete="off" />
                    <svg class="search__clear" id="searchClearButton" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px">
                        <path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z" />
                    </svg>
                </div>
            </div>
            <div class="panel__actions">
                <span class="selection-count" id="selectionCount"></span>
                <button class="form__button form__button--reset button--deselect-all" id="deselectAllButton" type="button" style="width: auto; padding: 0 var(--spacing-md); height: 40px;">
                    Deselect All
                </button>
                <button class="form__button form__button--danger button--batch-delete" id="batchDeleteButton" type="button" style="width: auto; padding: 0 var(--spacing-md); height: 40px;">
                    Delete Selected
                </button>
                <button class="form__button form__button--submit js-open-modal" data-type="Author" type="button" style="width: auto; padding: 0 var(--spacing-md); height: 40px;">
                    + Add Author
                </button>
            </div>
        </div>

        <div class="panel__table-container">
        <table class="table">
            <thead>
                <tr class="table__header">
                    <th class="table__cell table__cell--checkbox">
                        <input class="checkbox-styled" id="selectAll" type="checkbox" />
                    </th>
                    <th class="table__cell">Author Name</th>
                    <th class="table__cell">Books</th>
                    <th class="table__cell">ID</th>
                    <th class="table__cell">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.ExistingAuthors.Any())
                {
                    <tr class="table__row">
                        <td class="table__cell" colspan="3" style="text-align:center; color: var(--color-gray-500);">
                            No authors found.
                        </td>
                    </tr>
                }
                else 
                {
                    @foreach (var author in Model.ExistingAuthors)
                    {
                        <tr class="table__row">
                            <td class="table__cell table__cell--checkbox">
                                <input class="row-checkbox checkbox-styled" type="checkbox" name="ids" value="@author.Id" />
                            </td>
                            <td class="table__cell table__cell--main">@author.Name</td>
                            <td class="table__cell">
                                @if (author.Books.Count > 0)
                                {
                                    <span class="badge badge--primary" title="@author.Books.Count books">
                                        @author.Books.Count
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge--neutral">0</span>
                                }
                            </td>
                            <td class="table__cell table__cell--id">@author.Id</td>
                            <td class="table__cell">
                                <div class="table__actions">
                                    <button class="action__button js-open-modal"
                                            data-id="@author.Id"
                                            data-name="@author.Name"
                                            data-type="Author"
                                            title="Edit"
                                            type="button">
                                        <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000">
                                            <path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"/>
                                        </svg>
                                    </button>
                                    <button class="action__button action__button--delete js-delete-trigger" 
                                            data-id="@author.Id" 
                                            data-name="@author.Name" 
                                            title="Delete"
                                            type="button">
                                        <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000">
                                            <path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    </div>
</form>

<div class="modal" id="modal-edit">
    <div class="modal__container">
        <div class="modal__header">
            <h2 class="modal__title">Add/Edit Author</h2>
            <button class="modal__close js-close-modal" type="button">
                <svg class="close__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000">
                    <path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/>
                </svg>
            </button>
        </div>

        <form class="form__group" asp-action="SaveAuthor" method="post">
            <input asp-for="Form.Id" type="hidden" />

            <div class="form__field">
                <label class="field__label field__label--required" asp-for="Form.Name"></label>
                <input class="field__input input--text" asp-for="Form.Name" type="text" placeholder="e.g. J.K. Rowling" required data-trim autofocus />
                <span class="field__error" asp-validation-for="Form.Name"></span>
            </div>

            <div class="form__action" style="margin-top: var(--spacing-sm);">
                <button class="form__button form__button--reset js-cancel-modal" type="button">Cancel</button>
                <button class="form__button form__button--submit" type="submit">Save</button>
            </div>
        </form>
    </div>
</div>

<div class="modal" id="modal-delete">
    <div class="modal__container">
        <div class="modal__header">
            <h2 class="modal__title">Confirm Delete</h2>
            <button class="modal__close js-close-modal" type="button">
                <svg class="close__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000">
                    <path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/>
                </svg>
            </button>
        </div>

        <p class="modal__text">
            Are you sure you want to delete '<span class="text--highlight js-delete-name"></span>'?
            This action cannot be undone.
        </p>

        <form class="form__action" asp-action="DeleteAuthor" method="post">
            <input type="hidden" name="id" value="" />
            <button class="form__button form__button--reset js-cancel-delete" type="button">Cancel</button>
            <button class="form__button form__button--danger" type="submit">Delete</button>
        </form>
    </div>
</div>

@if (TempData["ShowModal"] as bool? == true)
{
    <div id="server-modal-trigger"></div>
}

@section foot {
    <script src="/js/book.js" asp-append-version="true"></script>
}