@model AuthorManagementVM

<table class="table">
    <thead>
        <tr class="table__header">
            <th class="table__cell table__cell--checkbox">
                <input class="checkbox-styled" id="selectAll" type="checkbox" />
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "Id" ? "active" : "")" data-sort="Id" data-order="@(Model.SortColumn == "Id" ? Model.SortOrder : "asc")" style="width: 80px;">
                ID
                @if (Model.SortColumn == "Id")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "Name" ? "active" : "")" data-sort="Name" data-order="@(Model.SortColumn == "Name" ? Model.SortOrder : "asc")">
                Author Name
                @if (Model.SortColumn == "Name")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "Books" ? "active" : "")" data-sort="Books" data-order="@(Model.SortColumn == "Books" ? Model.SortOrder : "asc")" style="width: 120px;">
                Books
                @if (Model.SortColumn == "Books")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell table__cell--actions" style="width: 100px; text-align: center;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.ExistingAuthors.Any())
        {
            <tr class="table__row">
                <td class="table__cell" colspan="5" style="text-align:center; color: var(--color-gray-500);">
                    No authors found.
                </td>
            </tr>
        }
        else 
        {
            @foreach (var author in Model.ExistingAuthors)
            {
                <tr class="table__row">
                    <td class="table__cell table__cell--checkbox">
                        <input class="row-checkbox checkbox-styled" type="checkbox" name="ids" value="@author.Id" data-name="@author.Name" data-books="@author.Books.Count" />
                    </td>
                    <td class="table__cell table__cell--id">@author.Id</td>
                    <td class="table__cell table__cell--main">@author.Name</td>
                    <td class="table__cell">
                        @{
                            var bookTitles = author.Books.OrderBy(b => b.Title).Take(5).Select(b => b.Title).ToList();
                            string tooltip = "No books linked";
                            if (bookTitles.Any())
                            {
                                tooltip = string.Join("\n", bookTitles);
                                if (author.Books.Count > 5)
                                {
                                    tooltip += $"\n... and {author.Books.Count - 5} more";
                                }
                            }
                        }
                        <a href="@Url.Action("ManageBook", "Book", new { authorId = author.Id })" class="count-badge @(author.Books.Count > 0 ? "count-badge--active" : "count-badge--empty")" title="@tooltip">
                            <svg class="count-badge__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960">
                                <path d="M260-320q47 0 91.5 10.5T440-278v-394q-36-14-74.5-21T260-700q-47 0-91.5 10.5T80-658v394q36-14 74.5-21T260-320Zm260 42q44-21 88.5-31.5T700-320q47 0 84.5 7t75.5 21v-394q-43-14-80.5-21T700-700q-47 0-91.5 10.5T520-658v394Zm-60 208q-54-27-109-40.5T260-124q-56 0-111 13.5T40-60v-540q51-24 107-36t113-12q57 0 113 12t107 36v540ZM520-70v-540q51-24 107-36t113-12q57 0 113 12t107 36v540q-56-50-111-63.5T700-124q-54 0-109 13.5T520-70Zm-40-508Z"/>
                            </svg>
                            <span>@author.Books.Count</span>
                        </a>
                    </td>
                    <td class="table__cell table__cell--actions">
                        <div class="table__actions">
                            <button class="action__button js-open-modal"
                                    data-id="@author.Id"
                                    data-name="@author.Name"
                                    data-type="Author"
                                    title="Edit"
                                    type="button">
                                <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000">
                                    <path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"/>
                                </svg>
                            </button>
                            <button class="action__button action__button--delete js-delete-trigger" 
                                    data-id="@author.Id" 
                                    data-name="@author.Name" 
                                    title="Delete"
                                    type="button">
                                <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000">
                                    <path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <button class="pagination__link" type="button" data-page="@(Model.CurrentPage - 1)">Previous</button>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <button class="pagination__link @(i == Model.CurrentPage ? "pagination__link--active" : "")" type="button" data-page="@i">@i</button>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <button class="pagination__link" type="button" data-page="@(Model.CurrentPage + 1)">Next</button>
        }
    </div>
}