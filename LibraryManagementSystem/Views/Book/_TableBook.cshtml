@model BookManagementVM

<table class="table">
    <thead>
        <tr class="table__header">
            <th class="table__cell table__cell--checkbox">
                <input class="checkbox-styled" id="selectAll" type="checkbox" />
            </th>
            <th class="table__cell" style="width: 60px;">Image</th>
            <th class="table__cell sortable-header @(Model.SortColumn == "Title" ? "active" : "")" data-sort="Title" data-order="@(Model.SortColumn == "Title" ? Model.SortOrder : "asc")">
                Title
                @if (Model.SortColumn == "Title")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "DateAdded" ? "active" : "")" data-sort="DateAdded" data-order="@(Model.SortColumn == "DateAdded" ? Model.SortOrder : "asc")" style="width: 180px; text-align: center;">
                Date Added
                @if (Model.SortColumn == "DateAdded")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell" style="width: 100px; text-align: center;">Featured</th>
            <th class="table__cell" style="width: 100px; text-align: center;">Archived</th>
            <th class="table__cell table__cell--actions" style="width: 100px; text-align: center;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.ExistingBooks.Any())
        {
            <tr class="table__row">
                <td class="table__cell" colspan="7" style="text-align:center; color: var(--color-gray-500);">
                    No books found.
                </td>
            </tr>
        }
        else 
        {
            @foreach (var book in Model.ExistingBooks)
            {
                <tr class="table__row">
                    <td class="table__cell table__cell--checkbox">
                        <input class="row-checkbox checkbox-styled" type="checkbox" name="ids" value="@book.Id" data-name="@book.Title" />
                    </td>
                    <td class="table__cell">
                        <img src="@(string.IsNullOrEmpty(book.ImageURL) ? "/images/assets/default-book.png" : $"/images/books/{book.ImageURL}")" 
                             alt="@book.Title" 
                             class="book-thumbnail" />
                    </td>
                    <td class="table__cell table__cell--main">
                        <div class="book-info">
                            <span class="book-title">@book.Title</span>
                            <span class="book-isbn">ISBN: @book.ISBN</span>
                        </div>
                    </td>
                    <td class="table__cell" style="text-align: center;">@book.DateAdded.ToString("yyyy-MM-dd")</td>
                    <td class="table__cell" style="text-align: center;">
                        <div class="switch-box__toggle" style="justify-content: center;">
                            <input class="toggle__input js-toggle-status" 
                                   type="checkbox" 
                                   data-id="@book.Id" 
                                   data-field="IsFeatured" 
                                   @(book.IsFeatured ? "checked" : "") />
                            <span class="toggle__slider"></span>
                        </div>
                    </td>
                    <td class="table__cell" style="text-align: center;">
                        <div class="switch-box__toggle" style="justify-content: center;">
                            <input class="toggle__input js-toggle-status" 
                                   type="checkbox" 
                                   data-id="@book.Id" 
                                   data-field="IsArchived" 
                                   @(book.IsArchived ? "checked" : "") />
                            <span class="toggle__slider"></span>
                        </div>
                    </td>
                    <td class="table__cell table__cell--actions">
                        <div class="table__actions">
                            <a asp-action="ManageBookDetail" asp-route-id="@book.Id" class="action__button" title="View Details">
                                <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000">
                                    <path d="M480-320q75 0 127.5-52.5T660-500q0-75-52.5-127.5T480-680q-75 0-127.5 52.5T300-500q0 75 52.5 127.5T480-320Zm0-72q-45 0-76.5-31.5T372-500q0-45 31.5-76.5T480-608q45 0 76.5 31.5T588-500q0 45-31.5 76.5T480-392Zm0 192q-146 0-266-81.5T40-500q54-137 174-218.5T480-800q146 0 266 81.5T920-500q-54 137-174 218.5T480-200Z"/>
                                </svg>
                            </a>
                            <button class="action__button action__button--add js-add-copy" 
                                    data-id="@book.Id" 
                                    data-title="@book.Title"
                                    title="Add Copy"
                                    type="button">
                                <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="M440-280h80v-160h160v-80H520v-160h-80v160H280v80h160v160Zm40 200q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                            </button>
                            <a asp-action="EditBook" asp-route-id="@book.Id" class="action__button action__button--edit" title="Edit">
                                <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000">
                                    <path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"/>
                                </svg>
                            </a>
                            <button class="action__button action__button--delete js-delete-trigger" 
                                    data-id="@book.Id" 
                                    data-name="@book.Title" 
                                    title="Delete"
                                    type="button">
                                <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000">
                                    <path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <button class="pagination__link" type="button" data-page="@(Model.CurrentPage - 1)">Previous</button>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <button class="pagination__link @(i == Model.CurrentPage ? "pagination__link--active" : "")" type="button" data-page="@i">@i</button>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <button class="pagination__link" type="button" data-page="@(Model.CurrentPage + 1)">Next</button>
        }
    </div>
}