@using Microsoft.AspNetCore.Mvc.Rendering
@model List<Book>
@{
    ViewBag.Title = "Catalogue";
}

@section head {
    <link rel="stylesheet" href="/css/book.css" asp-append-version="true" />
}

<div class="catalogue-layout">
    <div class="catalogue-toolbar" id="catalogueToolbar">
        <div class="toolbar-top">
            <h1 class="catalogue-title">Catalogue</h1>

            <div class="toolbar-actions">
                <div class="filter-menu" id="catalogueFilterMenu">
                    <button class="filter-menu__trigger" id="catalogueFilterTrigger">
                        <svg class="trigger__icon" xmlns="http://www.w3.org/2000/svg" height="20" viewBox="0 -960 960 960" width="20" fill="currentColor"><path d="M440-160q-17 0-28.5-11.5T400-200v-240L168-736q-15-20-4.5-42t36.5-22h560q26 0 36.5 22t-4.5 42L560-440v240q0 17-11.5 28.5T520-160h-80Zm40-308 198-252H282l198 252Zm0 0Z"/></svg>
                        <span>Filters</span>
                    </button>
                    <div class="filter-menu__dropdown">
                        <div class="filter-group">
                            <label class="filter-label">Genre</label>
                            <div class="filter-dropdown" id="dropdownGenre">
                                <input type="hidden" id="filterGenre" name="genreId" value="" />
                                <div class="filter-dropdown__trigger">
                                    <span class="trigger__text">All Genres</span>
                                    <svg class="trigger__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" height="24" width="24" fill="currentColor"><path d="M480-360 280-560h400L480-360Z"/></svg>
                                    <button class="filter-clear" type="button" title="Clear Filter">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>
                                    </button>
                                </div>
                                <div class="filter-dropdown__menu">
                                    <div class="filter-dropdown__item" data-value="">All Genres</div>
                                    @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Genres)
                                    {
                                        <div class="filter-dropdown__item" data-value="@item.Value">@item.Text</div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">Author</label>
                            <div class="filter-dropdown" id="dropdownAuthor">
                                <input type="hidden" id="filterAuthor" name="authorId" value="" />
                                <div class="filter-dropdown__trigger">
                                    <span class="trigger__text">All Authors</span>
                                    <svg class="trigger__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" height="24" width="24" fill="currentColor"><path d="M480-360 280-560h400L480-360Z"/></svg>
                                    <button class="filter-clear" type="button" title="Clear Filter">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>
                                    </button>
                                </div>
                                <div class="filter-dropdown__menu">
                                    <div class="filter-dropdown__item" data-value="">All Authors</div>
                                    @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Authors)
                                    {
                                        <div class="filter-dropdown__item" data-value="@item.Value">@item.Text</div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="filter-actions">
                            <button class="filter-action-clear" id="catalogueClearFilters">
                                <svg xmlns="http://www.w3.org/2000/svg" height="18" viewBox="0 -960 960 960" width="18" fill="currentColor"><path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/></svg>
                                Clear Filters
                            </button>
                        </div>
                    </div>
                </div>

                <div class="search__wrapper">
                    <svg class="search__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#999"><path d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>
                    <input class="search__input--header" id="catalogueSearchInput" type="text" placeholder="Search by title..." autocomplete="off" />
                    <svg class="search__clear" id="catalogueSearchClear" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px">
                        <path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <div class="catalogue-grid-wrapper" id="catalogueGrid">
            <partial name="_GridCatalogue" model="Model" />
    </div>
</div>

@section foot {
    <script src="/js/book.js" asp-append-version="true"></script>
}