@model BookDetailVM

<table class="table">
    <thead>
        <tr class="table__header">
            <th class="table__cell table__cell--checkbox">
                <input class="checkbox-styled" id="selectAll" type="checkbox" />
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "Id" ? "active" : "")" data-sort="Id" data-order="@(Model.SortColumn == "Id" ? Model.SortOrder : "asc")">
                ID
                @if (Model.SortColumn == "Id")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "Barcode" ? "active" : "")" data-sort="Barcode" data-order="@(Model.SortColumn == "Barcode" ? Model.SortOrder : "asc")">
                Barcode
                @if (Model.SortColumn == "Barcode")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "Status" ? "active" : "")" data-sort="Status" data-order="@(Model.SortColumn == "Status" ? Model.SortOrder : "asc")">
                Status
                @if (Model.SortColumn == "Status")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell table__cell--actions" style="width: 100px; text-align: center;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Copies.Any())
        {
            <tr class="table__row">
                <td class="table__cell" colspan="5" style="text-align:center; color: var(--color-gray-500);">
                    No copies found.
                </td>
            </tr>
        }
        else
        {
            @foreach (var copy in Model.Copies)
            {
                <tr class="table__row">
                    <td class="table__cell table__cell--checkbox">
                        <input class="row-checkbox checkbox-styled" type="checkbox" name="ids" value="@copy.Id" data-name="@copy.Barcode" />
                    </td>
                    <td class="table__cell table__cell--id">@copy.Id</td>
                    <td class="table__cell" style="font-family: monospace;">@copy.Barcode</td>
                    <td class="table__cell">
                        @{
                            string statusColor = copy.Status switch
                            {
                                Copy.CopyStatus.AVAILABLE => "var(--color-success)",
                                Copy.CopyStatus.BORROWED => "var(--color-warning)",
                                Copy.CopyStatus.RESERVED => "var(--color-primary-base)",
                                _ => "var(--color-gray-500)"
                            };
                        }
                        <span style="color: @statusColor; font-weight: 600;">@copy.Status</span>
                    </td>
                    <td class="table__cell table__cell--actions">
                        <div class="table__actions">
                            <button class="action__button action__button--delete js-delete-trigger" 
                                    data-id="@copy.Id" 
                                    data-name="@copy.Barcode" 
                                    title="Delete"
                                    type="button">
                                <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/></svg>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <button class="pagination__link" type="button" data-page="@(Model.CurrentPage - 1)">Previous</button>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <button class="pagination__link @(i == Model.CurrentPage ? "pagination__link--active" : "")" type="button" data-page="@i">@i</button>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <button class="pagination__link" type="button" data-page="@(Model.CurrentPage + 1)">Next</button>
        }
    </div>
}