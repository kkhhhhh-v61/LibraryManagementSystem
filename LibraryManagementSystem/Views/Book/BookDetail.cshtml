@model Book
@{
    ViewBag.Title = Model.Title;
    var reviews = ViewBag.Reviews as List<Review> ?? new List<Review>();
    var avgRating = (double)ViewBag.AverageRating;
    var available = (int)ViewBag.AvailableCopies;
    var total = (int)ViewBag.TotalCopies;
}

@section head {
    <link rel="stylesheet" href="/css/book.css" asp-append-version="true" />
}

<div class="public-detail-container">
    <div class="public-detail-card">
        <div class="public-detail-header">
            <a asp-action="Catalogue" class="btn button--back" title="Back">
                <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="m313-440 224 224-57 56-320-320 320-320 57 56-224 224h487v80H313Z"/></svg>
            </a>
        </div>

        <div class="public-detail-grid">
            <!-- Left: Image -->
            <div class="public-detail-image">
                <img src="@(string.IsNullOrEmpty(Model.ImageURL) ? "/images/assets/no-cover.jpg" : $"/images/books/{Model.ImageURL}")" alt="@Model.Title" />
            </div>

            <!-- Right: Info -->
            <div class="public-detail-info">
                <h1 class="public-detail-title">@Model.Title</h1>
                
                <div class="public-detail-meta-row">
                    <span class="meta-label">ISBN:</span>
                    <span class="meta-value" style="font-family: monospace;">@Model.ISBN</span>
                </div>

                <div class="public-detail-meta-grid">
                    <span class="meta-label">Authors</span>
                    <div class="meta-tags">
                        @foreach(var author in Model.Authors) { <span class="meta-tag">@author.Name</span> }
                    </div>

                    <span class="meta-label">Genres</span>
                    <div class="meta-tags">
                        @foreach(var genre in Model.Genres) { <span class="meta-tag">@genre.Name</span> }
                    </div>

                    <span class="meta-label">Publication</span>
                    <div class="meta-value">
                        @Model.PublicationYear • Edition @Model.Edition
                    </div>
                </div>

                <div class="public-detail-rating">
                    <div class="stars">
                        @for(int i=1; i<=5; i++) {
                            <i class="fa-solid fa-star @(i <= Math.Round(avgRating) ? "star-filled" : "star-empty")"></i>
                        }
                    </div>
                    <span class="rating-text">@avgRating.ToString("0.0") (@reviews.Count reviews)</span>
                </div>

                <div class="public-detail-actions" style="display: flex; gap: 0.5rem; align-items: flex-start;">
                    <div style="flex: 1; display: flex; flex-direction: column; gap: 0.5rem;">
                        @if (available > 0)
                        {
                            <div style="color: var(--color-success); font-weight: 600; display: flex; align-items: center; gap: 0.5rem;">
                                <i class="fa-solid fa-check-circle"></i> @available @(available == 1 ? "Copy" : "Copies") Available
                            </div>
                            <button type="button" class="form__button form__button--submit js-loan-trigger" data-book-id="@Model.Id" data-book-title="@Model.Title" style="width: 100%;">
                                <i class="fa-solid fa-book-open"></i> Loan
                            </button>
                        }
                        else
                        {
                            <div style="color: var(--color-error); font-weight: 600; display: flex; align-items: center; gap: 0.5rem;">
                                <i class="fa-solid fa-circle-xmark"></i> No Copies Available
                            </div>
                            <button type="button" class="form__button btn--secondary js-reserve-trigger" data-book-id="@Model.Id" data-book-title="@Model.Title" style="width: 100%;">
                                <i class="fa-solid fa-bookmark"></i> Reserve
                            </button>
                            <p style="font-size: 0.85rem; color: var(--color-gray-500);">
                                All copies are currently on loan. Place a reservation to join the queue.
                            </p>
                        }
                    </div>
                    
                    @if (User.Identity.IsAuthenticated)
                    {
                        <button type="button" class="form__button btn--secondary js-wishlist-trigger" onclick="toggleWishlist(this, '@Model.Id')" title="Add to Wishlist" style="width: 42px; padding: 0;">
                            <i class="fa-regular fa-heart"></i>
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="public-detail-separator"></div>

        <div class="public-detail-description">
            <h3>Description</h3>
            <p>@Model.Description</p>
        </div>

        <div class="public-detail-separator"></div>

        <div class="public-reviews-container">
        <h2 class="section-title">Reviews & Ratings</h2>
        
        @if(reviews.Count > 0)
        {
            <div class="reviews-list">
                @foreach(var review in reviews)
                {
                    <div class="review-card">
                        <div class="review-header">
                            <img src="@(string.IsNullOrEmpty(review.Loan.User.ImageURL) ? "/images/assets/default-profile.png" : $"/images/profiles/{review.Loan.User.ImageURL}")" class="review-avatar" />
                            <div class="review-user-info">
                                <span class="review-username">@review.Loan.User.Username</span>
                                <span class="review-date">@review.ReviewDate.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="review-stars">
                                @for(int i=1; i<=5; i++) {
                                    <i class="fa-solid fa-star @(i <= review.Rating ? "star-filled" : "star-empty")"></i>
                                }
                            </div>
                        </div>
                        <div class="review-body">
                            <p>@review.Comment</p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="no-reviews">
                <p>No reviews yet. Be the first to review this book!</p>
            </div>
        }
        </div>
    </div>
</div>

<div class="modal" id="modal-loan-confirm">
    <div class="modal__container">
        <div class="modal__header">
            <h2 class="modal__title">Confirm Loan</h2>
            <button class="modal__close js-close-modal" type="button">
                <svg class="close__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>
            </button>
        </div>
        <form class="modal__form" asp-controller="Loan" asp-action="Create" method="post">
            <div class="modal__content">
                <p class="modal__text" style="margin-bottom: 1rem;">
                    Please confirm the loan details for <span class="text--highlight js-loan-book-title"></span>:
                </p>
                <div style="background-color: var(--color-gray-100); padding: 1rem; border-radius: 0.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--color-gray-600);">Loan Date:</span>
                        <span style="font-weight: 600;" class="js-loan-date"></span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--color-gray-600);">Pickup By:</span>
                        <span style="font-weight: 600; color: var(--color-primary-base);" class="js-pickup-date"></span>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-top: 1px solid var(--color-gray-200); padding-top: 0.5rem; margin-top: 0.25rem;">
                        <span style="color: var(--color-gray-600);">Loan Duration:</span>
                        <span style="font-weight: 600;" class="js-loan-duration"></span>
                    </div>
                </div>
                <p class="modal__text" style="font-size: 0.85rem; color: var(--color-gray-500); margin-top: 1rem; text-align: center;">
                    * You must pick up the book at the library counter before the pickup deadline.
                </p>
                <input type="hidden" name="bookId" class="js-loan-book-id" value="" />
            </div>
            <div class="modal__footer">
                <button class="form__button form__button--cancel js-close-modal" type="button">Cancel</button>
                <button class="form__button form__button--submit" type="submit">Confirm</button>
            </div>
        </form>
    </div>
</div>

<div class="modal" id="modal-reserve">
    <div class="modal__container">
        <div class="modal__header">
            <h2 class="modal__title">Confirm Reservation</h2>
            <button class="modal__close js-close-modal" type="button">
                <svg class="close__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>
            </button>
        </div>
        <form class="modal__form" asp-controller="" asp-action="" method="post"> @* TODO: @Jason link this to your action method *@
            <div class="modal__content">
                <p class="modal__text">Are you sure you wish to reserve this book?</p>
            </div>
            <div class="modal__footer">
                <button class="form__button form__button--cancel js-close-modal" type="button">Cancel</button>
                <button class="form__button form__button--submit" type="submit">Confirm</button>
            </div>
        </form>
    </div>
</div>

@section foot {
    <script src="/js/book.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Check initial wishlist status
            const btn = document.querySelector(".js-wishlist-trigger");
            if (btn) {
                fetch(`/Wishlist/CheckStatus?bookId=@Model.Id`)
                    .then(res => res.json())
                    .then(data => {
                        const icon = btn.querySelector("i");
                        if (data.isInWishlist) {
                            icon.classList.remove("fa-regular");
                            icon.classList.add("fa-solid");
                        }
                    });
            }
        });
    </script>
}
