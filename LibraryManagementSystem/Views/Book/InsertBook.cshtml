@model BookInsertVM

@{
    ViewBag.Title = "Book Insert";
}

@section head {
    <link rel="stylesheet" href="/css/book.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
}

<form class="form js-warn-unsaved" asp-action="InsertBook" method="post" enctype="multipart/form-data">
    <h1 class="form__title">Insert Book</h1>
    <input type="hidden" asp-for="CropX" />
    <input type="hidden" asp-for="CropY" />
    <input type="hidden" asp-for="CropWidth" />
    <input type="hidden" asp-for="CropHeight" />

    <div class="form__content">
        <div class="form__group form__group--left">
            <div class="form__field">
                <label class="field__label" asp-for="Image"></label>
                <div class="upload__wrapper">
                    <label class="upload__zone">
                        <div class="upload__placeholder">
                            <svg class="upload__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960">
                                <path d="M440-320v-326L336-542l-56-58 200-200 200 200-56 58-104-104v326h-80ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z"/>
                            </svg>
                            <span class="upload__text">Upload Image File</span>
                        </div>
                        <img class="upload__preview" />
                        <input class="upload__input" asp-for="Image" type="file" accept="image/jpeg, image/jpg, image/png" />
                    </label>
                    <button class="upload__remove" type="button">
                        <svg class="upload__remove-icon" xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#ffffff">
                            <path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/>
                        </svg>
                    </button>
                </div>
                <span class="field__error" asp-validation-for="Image"></span>
            </div>
        </div>
        <div class="form__group form__group--right">
            <div class="form__field">
                <label class="field__label field__label--required" asp-for="Title"></label>
                <input class="field__input input--text" asp-for="Title" type="text" required data-trim autofocus />
                <span class="field__error" asp-validation-for="Title"></span>
            </div>
            <div class="form__field">
                <label class="field__label field__label--required" asp-for="Description"></label>
                <textarea class="field__input input--textarea" asp-for="Description" required data-trim></textarea>
                <span class="field__error" asp-validation-for="Description"></span>
            </div>
            <div class="form__field">
                <label class="field__label field__label--required" asp-for="ISBN"></label>
                <input class="field__input input--text" asp-for="ISBN" type="text" required data-trim />
                <span class="field__error" asp-validation-for="ISBN"></span>
            </div>
            <div class="form__section">
                <div class="form__field">
                    <label class="field__label field__label--required" asp-for="PublicationYear"></label>
                    <input class="field__input input--number" asp-for="PublicationYear" type="number" min="1450" max="2100" step="1" required data-trim />
                    <span class="field__error" asp-validation-for="PublicationYear"></span>
                </div>
                <div class="form__field">
                    <label class="field__label field__label--required" asp-for="Edition"></label>
                    <input class="field__input input--number" asp-for="Edition" type="number" min="1" max="100" step="1" required data-trim />
                    <span class="field__error" asp-validation-for="Edition"></span>
                </div>
            </div>
            <div class="form__section">
                <div class="form__field">
                    <label class="field__label field__label--required" asp-for="SelectedGenreIds"></label>
                    <div class="field__multi-select">
                        <div class="multi-select__search">
                            <input class="search__input" type="text" placeholder="Search for genres..." />
                        </div>
                        <div class="multi-select__dropdown">
                            @foreach (var item in Model.GenreList)
                            {
                                <div class="dropdown__option" data-value="@item.Value">@item.Text</div>
                            }
                        </div>
                        <select class="multi-select__select" asp-for="SelectedGenreIds" multiple>
                            @foreach (var item in Model.GenreList)
                            {
                                <option class="select__option" value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <span class="field__error" asp-validation-for="SelectedGenreIds"></span>
                </div>
                <div class="form__field">
                    <label class="field__label field__label--required" asp-for="SelectedAuthorIds"></label>
                    <div class="field__multi-select">
                        <div class="multi-select__search">
                            <input class="search__input" type="text" placeholder="Search for authors..." />
                        </div>
                        <div class="multi-select__dropdown">
                            @foreach (var item in Model.AuthorList)
                            {
                                <div class="dropdown__option" data-value="@item.Value">@item.Text</div>
                            }
                        </div>
                        <select class="multi-select__select" asp-for="SelectedAuthorIds" multiple>
                            @foreach (var item in Model.AuthorList)
                            {
                                <option class="select__option" value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <span class="field__error" asp-validation-for="SelectedAuthorIds"></span>
                </div>
            </div>
            <div class="form__section">
                <div class="form__field">
                    <div class="field__switch-box">
                        <label class="switch-box__header">
                            <label class="switch-box__label" asp-for="IsFeatured"></label>
                            <div class="switch-box__toggle">
                                <input class="toggle__input" asp-for="IsFeatured" type="checkbox" />
                                <span class="toggle__slider"></span>
                            </div>
                        </label>
                        <p class="switch-box__text">Display this Book in the <b>Featured</b> section of the <b>Home</b> page.</p>
                    </div>
                </div>
                <div class="form__field">
                    <div class="field__switch-box">
                        <label class="switch-box__header">
                            <label class="switch-box__label" asp-for="IsArchived"></label>
                            <div class="switch-box__toggle">
                                <input class="toggle__input" asp-for="IsArchived" type="checkbox" />
                                <span class="toggle__slider"></span>
                            </div>
                        </label>
                        <p class="switch-box__text">Archive this Book from being displayed in the <b>Catalogue</b>.</p>
                    </div>
                </div>
            </div>
            <div class="form__action">
                <a asp-action="ManageBook" class="form__button form__button--cancel">Cancel</a>
                <button class="form__button form__button--reset" type="reset">Reset</button>
                <button class="form__button form__button--submit" type="submit">Submit</button>
            </div>
        </div>
    </div>
</form>

<div class="modal" id="modal-book-crop">
    <div class="modal__container" style="max-width: 600px;">
        <div class="modal__header">
            <h2 class="modal__title">Crop Cover Image</h2>
            <button class="modal__close js-close-modal" type="button"><svg class="close__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg></button>
        </div>
        <div class="modal__content" style="background-color: #000; display: flex; justify-content: center; align-items: center; min-height: 300px;">
            <img id="book-crop-image" style="max-width: 100%; max-height: 60vh; display: block;" />
        </div>
        <div class="modal__footer">
            <button class="form__button form__button--cancel js-close-modal" type="button">Cancel</button>
            <button class="form__button form__button--reset" id="btn-reset-crop" type="button">Reset</button>
            <button class="form__button form__button--submit" id="btn-confirm-crop" type="button">Crop & Save</button>
        </div>
    </div>
</div>

@section foot {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <script src="/js/book.js" asp-append-version="true"></script>
}
