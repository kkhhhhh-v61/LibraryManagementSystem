@model BookManagementVM

@{
    ViewBag.Title = "Book Maintenance";
}

@section head {
    <link rel="stylesheet" href="/css/book.css" asp-append-version="true" />
}

<form class="manage__content" asp-action="BatchDeleteBook" method="post" id="batchForm">
    <div class="manage__panel">
        <div class="panel__header">
            <div class="header__start">
                <h2 class="panel__title">Books (@ViewBag.TotalItems)</h2>
            </div>
            <div class="header__controls">
                <div class="header__filters">
                    <div class="filter-menu" id="filterMenu">
                        <button class="filter-menu__trigger" type="button" id="filterMenuTrigger">
                            <svg class="trigger__icon" xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#666">
                                <path d="M440-160q-17 0-28.5-11.5T400-200v-240L168-736q-15-20-4.5-42t36.5-22h560q26 0 36.5 22t-4.5 42L560-440v240q0 17-11.5 28.5T520-160h-80Zm40-308 198-252H282l198 252Zm0 0Z"/>
                            </svg>
                            <span class="trigger__text">Filters</span>
                        </button>
                        <div class="filter-menu__dropdown">
                            <div class="filter-group">
                                <label class="filter-label">Author</label>
                                <div class="filter-dropdown" id="authorFilterWrapper" style="width: 100%;">
                                    <input type="hidden" id="filterAuthor" value="@Model.SelectedAuthorId" />
                                    <button class="filter-dropdown__trigger" type="button">
                                        <span class="trigger__text">
                                            @{
                                                var selectedAuthor = Model.AuthorList.FirstOrDefault(a => a.Value == Model.SelectedAuthorId);
                                                @(selectedAuthor != null ? selectedAuthor.Text : "All Authors")
                                            }
                                        </span>
                                        <svg class="trigger__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="M480-360 280-560h400L480-360Z"/></svg>
                                    </button>
                                    <button class="filter-clear" type="button" title="Clear Filter"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg></button>
                                    <div class="filter-dropdown__menu">
                                        <div class="filter-dropdown__item @(string.IsNullOrEmpty(Model.SelectedAuthorId) ? "selected" : "")" data-value="">All Authors</div>
                                        @foreach (var item in Model.AuthorList)
                                        {
                                            <div class="filter-dropdown__item @(item.Value == Model.SelectedAuthorId ? "selected" : "")" data-value="@item.Value">@item.Text</div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="filter-group">
                                <label class="filter-label">Genre</label>
                                <div class="filter-dropdown" id="genreFilterWrapper" style="width: 100%;">
                                    <input type="hidden" id="filterGenre" value="@Model.SelectedGenreId" />
                                    <button class="filter-dropdown__trigger" type="button">
                                        <span class="trigger__text">
                                            @{
                                                var selectedGenre = Model.GenreList.FirstOrDefault(g => g.Value == Model.SelectedGenreId);
                                                @(selectedGenre != null ? selectedGenre.Text : "All Genres")
                                            }
                                        </span>
                                        <svg class="trigger__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="M480-360 280-560h400L480-360Z"/></svg>
                                    </button>
                                    <button class="filter-clear" type="button" title="Clear Filter"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg></button>
                                    <div class="filter-dropdown__menu">
                                        <div class="filter-dropdown__item @(string.IsNullOrEmpty(Model.SelectedGenreId) ? "selected" : "")" data-value="">All Genres</div>
                                        @foreach (var item in Model.GenreList)
                                        {
                                            <div class="filter-dropdown__item @(item.Value == Model.SelectedGenreId ? "selected" : "")" data-value="@item.Value">@item.Text</div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="filter-group">
                                <label class="filter-label">Date Added</label>
                                <div class="filter-date-range" style="display: flex; gap: 0.5rem; align-items: center;">
                                    <input type="date" id="filterDateFrom" class="filter-input" 
                                           min="@ViewBag.MinDate" max="@ViewBag.MaxDate" value="@ViewBag.DateFrom" 
                                           style="width: 100%; padding: 8px; border: 1px solid var(--color-gray-300); border-radius: var(--spacing-sm); font-family: var(--font-main);" />
                                    <span style="color: var(--color-gray-500);">-</span>
                                    <input type="date" id="filterDateTo" class="filter-input" 
                                           min="@ViewBag.MinDate" max="@ViewBag.MaxDate" value="@ViewBag.DateTo"
                                           style="width: 100%; padding: 8px; border: 1px solid var(--color-gray-300); border-radius: var(--spacing-sm); font-family: var(--font-main);" />
                                </div>
                            </div>
                            <div class="filter-group">
                                <label class="filter-label">Status</label>
                                <div class="filter-toggles">
                                    <div class="toggle-option">
                                        <span class="toggle-label">Featured</span>
                                        <div class="switch-box__toggle">
                                            <input type="checkbox" id="filterFeatured" class="toggle__input" @(Model.FilterFeatured == true ? "checked" : "") />
                                            <span class="toggle__slider"></span>
                                        </div>
                                    </div>
                                    <div class="toggle-option">
                                        <span class="toggle-label">Archived</span>
                                        <div class="switch-box__toggle">
                                            <input type="checkbox" id="filterArchived" class="toggle__input" @(Model.FilterArchived == true ? "checked" : "") />
                                            <span class="toggle__slider"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="filter-actions">
                                <button type="button" id="clearFilters" class="filter-action-clear">
                                    <svg xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor"><path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/></svg>
                                    Clear All Filters
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="search__wrapper">
                    <svg class="search__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#999">
                        <path d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z" />
                    </svg>
                    <input class="search__input--header" id="nameSearchInput" type="text" placeholder="Search books..." autocomplete="off" data-trim />
                    <svg class="search__clear" id="searchClearButton" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px">
                        <path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="panel__table-container" id="tableContainer">
            <partial name="_TableBook" model="Model" />
        </div>

        <div class="action-bar">
            <div class="action-bar__selection">
                <span class="selection-count" id="selectionCount"></span>
                <button class="form__button form__button--cancel button--deselect-all" id="deselectAllButton" type="button">
                    Deselect All
                </button>
                @if (User.IsInRole("ADMIN"))
                {
                    <button class="form__button form__button--danger button--batch-delete" id="batchDeleteButton" type="button">
                        Delete Selected
                    </button>
                }
            </div>
            <a asp-action="InsertBook" class="form__button form__button--submit">
                + Add Book
            </a>
        </div>
    </div>
</form>

<div class="modal" id="modal-delete">
    <div class="modal__container">
        <div class="modal__header">
            <h2 class="modal__title">Confirm Delete</h2>
            <button class="modal__close js-close-modal" type="button">
                <svg class="close__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px">
                    <path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/>
                </svg>
            </button>
        </div>

        <form class="modal__form" asp-action="DeleteBook" method="post">
            <div class="modal__content">
                <p class="modal__text">
                    Are you sure you want to delete '<span class="text--highlight js-delete-name"></span>'?
                    This action cannot be undone.
                </p>
                <input type="hidden" name="id" value="" />
            </div>
            <div class="modal__footer">
                <button class="form__button form__button--cancel js-cancel-delete" type="button">Cancel</button>
                <button class="form__button form__button--danger" type="submit">Delete</button>
            </div>
        </form>
    </div>
</div>

<div class="modal" id="modal-batch-delete">
    <div class="modal__container">
        <div class="modal__header">
            <h2 class="modal__title">Confirm Batch Delete</h2>
            <button class="modal__close js-close-modal" type="button">
                <svg class="close__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px">
                    <path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z" />
                </svg>
            </button>
        </div>
        <div class="modal__content">
            <p class="modal__text">The following items will be processed:</p>
            <div class="delete-list" id="batchDeleteList"></div>
        </div>
        <div class="modal__footer">
            <button class="form__button form__button--cancel js-cancel-batch" type="button">Cancel</button>
            <button class="form__button form__button--danger" id="confirmBatchDelete" type="button">Confirm Delete</button>
        </div>
    </div>
</div>

<div class="modal" id="modal-add-copy">
    <div class="modal__container">
        <div class="modal__header">
            <h2 class="modal__title">Add Copies</h2>
            <button class="modal__close js-close-modal" type="button">
                <svg class="close__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>
            </button>
        </div>
        <form class="modal__form" asp-action="AddCopy" method="post">
            <div class="modal__content">
                <input type="hidden" name="bookId" id="addCopyBookId" />
                <p class="modal__text" style="margin-bottom: 1rem;">
                    Adding copies for: <span class="text--highlight" id="addCopyBookTitle"></span>
                </p>
                <div class="form__field">
                    <label class="field__label field__label--required">Quantity</label>
                    <input class="field__input input--number" name="quantity" type="number" min="1" max="100" value="1" required />
                </div>
                <div class="form__field" style="margin-top: var(--spacing-sm);">
                    <label class="field__label">Existing Copies</label>
                    <div id="addCopyExistingList" class="modal__list-container"></div>
                </div>
            </div>
            <div class="modal__footer">
                <button class="form__button form__button--cancel js-cancel-modal" type="button">Cancel</button>
                <button class="form__button form__button--submit" type="submit">Add Copies</button>
            </div>
        </form>
    </div>
</div>

<div class="modal" id="modal-copy-summary">
    <div class="modal__container">
        <div class="modal__header">
            <h2 class="modal__title">Copies Added</h2>
            <button class="modal__close js-close-modal" type="button"><svg class="close__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg></button>
        </div>
        <div class="modal__content">
            <p class="modal__text">The following copies have been successfully generated:</p>
            <div class="delete-list" id="copySummaryList"></div>
        </div>
        <div class="modal__footer">
            <button class="form__button form__button--submit js-close-modal" type="button">Close</button>
        </div>
    </div>
</div>

<div class="modal" id="modal-toggle-confirm">
    <div class="modal__container">
        <div class="modal__header">
            <h2 class="modal__title">Confirm Action</h2>
            <button class="modal__close js-close-modal" type="button">
                <svg class="close__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>
            </button>
        </div>
        <div class="modal__content">
            <p class="modal__text" id="toggleConfirmText">
                Are you sure you want to change this setting?
            </p>
            <div style="margin-top: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                <input type="checkbox" id="dontAskAgain" class="checkbox-styled" />
                <label for="dontAskAgain" style="color: var(--color-gray-700); cursor: pointer; user-select: none;">Don't ask me again for this session</label>
            </div>
        </div>
        <div class="modal__footer">
            <button class="form__button form__button--cancel js-cancel-toggle" type="button">Cancel</button>
            <button class="form__button form__button--submit" id="confirmToggleBtn" type="button">Confirm</button>
        </div>
    </div>
</div>

@section foot {
    <script src="/js/book.js" asp-append-version="true"></script>

    @if (TempData["BookInsertSuccess"] != null)
    {
        <script>
            sessionStorage.removeItem("temp_image_data");
            sessionStorage.removeItem("form_submitting");
        </script>
    }

    @if (TempData["AddedCopies"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const addedCopies = @Html.Raw(TempData["AddedCopies"]);
                const summaryModal = document.getElementById("modal-copy-summary");
                const listContainer = document.getElementById("copySummaryList");
                
                if (summaryModal && listContainer && addedCopies.length > 0) {
                    listContainer.innerHTML = addedCopies.map(copy => `
                        <div class="delete-item">
                            <div class="delete-item__info"><span class="delete-item__name">ID: ${copy.Id}</span><span class="delete-item__status" style="color: var(--color-gray-600);">Barcode: ${copy.Barcode}</span></div>
                            <svg class="delete-item__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="#22c55e"><path d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z"/></svg>
                        </div>
                    `).join("");
                    summaryModal.classList.add("active");
                }
            });
        </script>
    }
}
