@using LibraryManagementSystem.Models
@model List<RoomCategory>

<div class="table-wrapper">
    @if (Model.Count == 0)
    {
        <div style="text-align:center; padding: 20px; color: #999;">
            <p>No categories found.</p>
        </div>
    }
    else
    {
        <table class="modern-table">
            <thead>
                <tr>
                    <th style="width:10%">
                        <a asp-action="Index"
                           asp-route-sortOrder="@ViewData["IdSortParm"]"
                           asp-route-search="@ViewData["CurrentFilter"]"
                           data-ajax="true"
                           data-ajax-update="#resultContainer"
                           data-ajax-loading="#loader"
                           style="color: inherit; text-decoration: none; cursor: pointer;">
                            ID
                            @if (ViewData["CurrentSort"]?.ToString() == "id_asc")
                            {
                                <span>▲</span>
                            }
                            else if (string.IsNullOrEmpty(ViewData["CurrentSort"]?.ToString()))
                            {

                                <span>▼</span>
                            }
                        </a>
                    </th>

                    <th style="width:25%">
                        <a asp-action="Index"
                           asp-route-sortOrder="@ViewData["NameSortParm"]"
                           asp-route-search="@ViewData["CurrentFilter"]"
                           data-ajax="true"
                           data-ajax-update="#resultContainer"
                           data-ajax-loading="#loader"
                           style="color: inherit; text-decoration: none; cursor: pointer;">
                            Name
                            @if (ViewData["CurrentSort"]?.ToString() == "Name")
                            {
                                <span>▲</span>
                            }
                            else if (ViewData["CurrentSort"]?.ToString() == "name_desc")
                            {

                                <span>▼</span>
                            }
                        </a>
                    </th>

                    <th style="width:15%">
                        <a asp-action="Index"
                           asp-route-sortOrder="@ViewData["RateSortParm"]"
                           asp-route-search="@ViewData["CurrentFilter"]"
                           data-ajax="true"
                           data-ajax-update="#resultContainer"
                           data-ajax-loading="#loader"
                           style="color: inherit; text-decoration: none; cursor: pointer;">
                            Rate
                            @if (ViewData["CurrentSort"]?.ToString() == "Rate")
                            {
                                <span>▲</span>
                            }
                            else if (ViewData["CurrentSort"]?.ToString() == "rate_desc")
                            {

                                <span>▼</span>
                            }
                        </a>
                    </th>

                    <th style="width:35%">Description</th>
                    <th style="width:15%; text-align:right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><code>@item.Id</code></td>
                        <td><strong>@item.Name</strong></td>
                        <td>RM @item.HourlyRate.ToString("F2")</td>
                        <td style="color:var(--text-muted); max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            @item.Description
                        </td>
                        <td style="text-align:right;">
                            <div style="display:flex; gap:5px; justify-content:flex-end;">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon" title="Edit Category">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>