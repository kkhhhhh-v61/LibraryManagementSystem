@using LibraryManagementSystem.Models
@model RoomIndexVM

@{
    ViewBag.Title = "Room Manager";
}

@section head {
    <link rel="stylesheet" href="/css/room.css" asp-append-version="true" />
}

<div class="dashboard-container">

    <div class="panel panel-fill">
        <div class="panel-header" style="justify-content: space-between;">
            <div style="display:flex; align-items:center; gap:15px;">
                <div class="panel-title">
                    Room Categories
                </div>
                <span class="badge badge-neutral">@Model.Categories.Count Records</span>
            </div>

            <form asp-action="Index" method="get"
                  data-ajax="true"
                  data-ajax-update="#resultContainer"
                  data-ajax-loading="#loader"
                  id="searchForm">

                <div class="search-container">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>

                    <input type="text" name="search" class="search-input" placeholder="Search categories..." autocomplete="off" oninput="submitSearch()">

                    <div id="loader" class="loading-spinner"></div>
                </div>
            </form>
        </div>

        <div id="resultContainer">
            <partial name="_CategoryTable" model="Model.Categories" />
        </div>
    </div>

    <div class="right-sidebar-container">

        <div class="panel panel-auto">
            <div class="panel-header"><div class="panel-title">Add Category</div></div>
            <div class="panel-body">
                <form id="formCreateCategory" onsubmit="submitCategory(event)" class="form-stack" enctype="multipart/form-data">

                    <div class="form-group">
                        <label class="form-label">Name</label>
                        <input asp-for="CategoryInput.Name" class="form-input" placeholder="e.g. Gaming Room" data-trim autofocus />
                        <span asp-validation-for="CategoryInput.Name" class="text-danger" style="font-size:0.8rem; color:var(--danger);"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Rate (RM/Hr)</label>
                        <input asp-for="CategoryInput.HourlyRate" class="form-input" placeholder="0.00" type="number" step="0.01" data-trim />
                        <span asp-validation-for="CategoryInput.HourlyRate" class="text-danger" style="font-size:0.8rem; color:var(--danger);"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Description</label>
                        <textarea asp-for="CategoryInput.Description" class="form-input" rows="2" data-trim></textarea>
                        <span asp-validation-for="CategoryInput.Description" class="text-danger" style="font-size:0.8rem; color:var(--danger);"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Image</label>
                        <input asp-for="CategoryInput.Image" class="form-input" type="file" accept="image/*" />
                    </div>

                    <button type="submit" class="btn-save">Create Category</button>
                </form>
            </div>
        </div>

        <div class="panel panel-auto">
            <div class="panel-header"><div class="panel-title">Add Room</div></div>
            <div class="panel-body scrollable-panel-body">
                <form id="formCreateRoom" onsubmit="submitRoom(event)" class="form-stack" enctype="multipart/form-data">

                    <div class="form-group">
                        <label class="form-label">Room Name</label>
                        <input asp-for="RoomInput.Name" class="form-input" placeholder="e.g. Room A" data-trim />
                        <span asp-validation-for="RoomInput.Name" class="text-danger" style="font-size:0.8rem; color:var(--danger);"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Location</label>
                        <input asp-for="RoomInput.Location" class="form-input" placeholder="Level 1" data-trim />
                        <span asp-validation-for="RoomInput.Location" class="text-danger" style="font-size:0.8rem; color:var(--danger);"></span>
                    </div>

                    <div class="form-grid" style="grid-template-columns: 1fr 1fr; display:grid; gap:10px;">
                        <div class="form-group">
                            <label class="form-label">Capacity</label>
                            <input asp-for="RoomInput.Capacity" class="form-input" />
                            <span asp-validation-for="RoomInput.Capacity" class="text-danger" style="font-size:0.8rem; color:var(--danger);"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Category</label>
                            <select asp-for="RoomInput.RoomCategoryId" class="form-input" asp-items="ViewBag.CategoryList">
                                <option value="">Select...</option>
                            </select>
                            <span asp-validation-for="RoomInput.RoomCategoryId" class="text-danger" style="font-size:0.8rem; color:var(--danger);"></span>
                        </div>
                    </div>

                    <input type="hidden" asp-for="RoomInput.Status" value="AVAILABLE" />

                    <button type="submit" class="btn-save" style="background-color:var(--success);">Create Room</button>
                </form>
            </div>
        </div>

    </div>
</div>

@section foot {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="/js/room.js" asp-append-version="true"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-ajax-unobtrusive/3.2.6/jquery.unobtrusive-ajax.min.js"></script>
    

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let timeout = null;

        // 这个函数绑定在输入框的 oninput 上
        function submitSearch() {
            clearTimeout(timeout);
            // 延迟 500ms 提交，防止请求过于频繁
            timeout = setTimeout(function () {
                $("#searchForm").submit();
            }, 500);
        }

        $(document).ready(function () {
            @if (TempData["Success"] != null)
            {
                        <text>
                            showToast('@TempData["Success"]', 'success');
                        </text>
            }

            @if (TempData["Error"] != null)
            {
                        <text>
                            showToast('@TempData["Error"]', 'error');
                        </text>
            }

            @if (!ViewData.ModelState.IsValid && TempData["Error"] == null)
            {
                        <text>
                            showToast('Please check input fields.', 'error');
                        </text>
            }
        });
    </script>
}
