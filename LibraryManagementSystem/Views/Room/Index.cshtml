@using LibraryManagementSystem.Models
@model RoomIndexVM

@{
    ViewBag.Title = "Room Manager";
}

@section head {
    <link rel="stylesheet" href="/css/room.css" asp-append-version="true" />
}

<div class="dashboard-container">

    <div class="panel panel-fill">
        <div class="panel-header" style="justify-content: space-between;">
            <div style="display:flex; align-items:center; gap:15px;">
                <div class="panel-title">
                    Room Categories
                </div>
                <span class="badge badge-neutral">@Model.Categories.Count Records</span>
            </div>

            <form asp-action="Index" method="get"
                  data-ajax="true"
                  data-ajax-update="#resultContainer"
                  data-ajax-loading="#loader"
                  id="searchForm">

                <div class="search-container">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>

                    <input type="text" name="search" class="search-input" placeholder="Search categories..." autocomplete="off" oninput="submitSearch()">
                    <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
                    <div id="loader" class="loading-spinner"></div>
                </div>
            </form>
        </div>

        <div id="resultContainer">
            <partial name="_CategoryTable" model="Model.Categories" />
        </div>
    </div>

    <div class="right-sidebar-container">

        <div class="panel panel-auto">
            <div class="panel-header"><div class="panel-title">Add Category</div></div>
            <div class="panel-body">

                <div id="createCategoryContainer">
                    <partial name="_CreateCategoryForm" model="Model" />
                </div>

            </div>
        </div>

        <div class="panel panel-auto">
            <div class="panel-header"><div class="panel-title">Add Room</div></div>
            <div class="panel-body scrollable-panel-body">

                <div id="createRoomContainer">
                    <partial name="_CreateRoomForm" model="Model" />
                </div>

            </div>
        </div>

    </div>

</div>

@section foot {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="/js/room.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-ajax-unobtrusive/3.2.6/jquery.unobtrusive-ajax.min.js"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            @if (TempData["Success"] != null)
            {
                    <text>if(window.showToast) showToast('@TempData["Success"]', 'success');</text>
            }

            @if (TempData["Error"] != null)
            {
                    <text>if(window.showToast) showToast('@TempData["Error"]', 'error');</text>
            }

            @if (!ViewData.ModelState.IsValid && TempData["Error"] == null)
            {
                    <text>if(window.showToast) showToast('Please check input fields.', 'error');</text>
            }
        });
    </script>
}
