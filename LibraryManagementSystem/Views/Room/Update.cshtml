@{
    ViewBag.Title = "Update Category";
}

@section Head {
    <link rel="stylesheet" href="/css/room.css" asp-append-version="true" />
}

<div class="update-page-container">

    <div class="nav-back-bar">
        <a href="/Room" style="text-decoration:none; color:#6b7280; display:inline-flex; align-items:center; gap:6px; font-weight:600; font-size:0.95rem; transition:color 0.2s;">
            <div style="background:white; border:1px solid #e5e7eb; border-radius:6px; padding:4px; display:flex;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
            </div>
            Back to Dashboard
        </a>
        <span style="font-size:0.85rem; color:#9ca3af;">Last updated: Today, 10:42 AM</span>
    </div>

    <div class="panel-top">
        <div class="panel-header">
            <h2 class="panel-title" style="display:flex; align-items:center; gap:10px;">
                <span style="background:#eef2ff; padding:6px; border-radius:8px; color:#4f46e5;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                </span>
                Edit Category
            </h2>

            <div style="display:flex; gap:10px;">
                <span style="background:#ecfdf5; color:#059669; padding:6px 12px; border-radius:20px; font-size:0.8rem; font-weight:700; border:1px solid #a7f3d0;">
                    Active Status
                </span>
            </div>
        </div>

        <div class="panel-body" style="padding-bottom: 1.5rem;">
            <form asp-action="Edit" method="post">

                <div class="form-horizontal-grid">

                    <div class="form-group">
                        <label class="form-label">ID</label>
                        <input type="text" name="Id" class="form-input" value="C01" readonly style="background:#f9fafb; color:#6b7280; font-family:monospace;">
                    </div>

                    <div class="form-group">
                        <label class="form-label">Category Name</label>
                        <input type="text" name="Name" class="form-input" value="Discussion Room" style="font-weight:600;">
                    </div>

                    <div class="form-group">
                        <label class="form-label">Hourly Rate</label>
                        <div style="position:relative;">
                            <span style="position:absolute; left:12px; top:10px; color:#9ca3af; font-size:0.9rem;">RM</span>
                            <input type="number" name="HourlyRate" class="form-input" value="5.00" step="0.01" style="padding-left:40px;">
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Status</label>
                        <select name="Status" class="form-input">
                            <option selected>Active</option>
                            <option>Inactive</option>
                        </select>
                    </div>

                    <div class="form-group form-full-width">
                        <label class="form-label">Description & Amenities</label>
                        <textarea name="Description" class="form-input" rows="2" style="resize:none;">Standard room for 4-6 pax with whiteboard setup.</textarea>
                    </div>

                </div>

                <div style="margin-top: 1.5rem; display:flex; justify-content:flex-end; gap:10px; border-top:1px solid #f3f4f6; padding-top:1rem;">
                    <button type="button" class="btn-action" style="background:white; border:1px solid #e5e7eb; color:#374151; width:auto; padding:0.6rem 1.2rem;">Discard</button>
                    <button type="submit" class="btn-save" style="width: auto; padding: 0.6rem 2rem; margin:0;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <div class="panel-bottom-fill">
        <div class="panel-header">
            <div class="section-title" style="display:flex; align-items:center; font-weight:700; gap:10px;">
                🚪 Associated Rooms
                <span style="font-size:0.8rem; background:#f3f4f6; color:#4b5563; padding:2px 8px; border-radius:6px; border:1px solid #e5e7eb;">
                    4 Total
                </span>
            </div>
            <button class="btn-save" style="width:auto; padding: 6px 16px; font-size:0.85rem;" onclick="alert('Trigger Add Room Modal')">+ Add Room</button>
        </div>

        <div class="panel-body" style="padding:0;">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th style="width: 20%; padding-left:1.5rem;">Room ID</th>
                        <th style="width: 20%;">Capacity</th>
                        <th style="width: 20%;">Current Status</th>
                        <th style="width: 25%;">Next Booking</th>
                        <th style="width: 15%; text-align: right; padding-right:1.5rem;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="padding-left:1.5rem;"><strong>R-101</strong></td>
                        <td style="color:#6b7280;">4 Pax</td>
                        <td><span style="color:#059669; background:#ecfdf5; padding:4px 10px; border-radius:6px; font-size:0.75rem; font-weight:700;">Available</span></td>
                        <td style="font-size:0.85rem; color:#6b7280;">Today, 2:00 PM</td>
                        <td style="text-align: right; padding-right:1.5rem;">
                            <button class="btn-icon" onclick="openEditModal('R-101', 4, 'Available')">✎</button>
                            <button class="btn-icon btn-delete" style="color:#ef4444; border-color:#fee2e2;">🗑️</button>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding-left:1.5rem;"><strong>R-102</strong></td>
                        <td style="color:#6b7280;">6 Pax</td>
                        <td><span style="color:#b45309; background:#fffbeb; padding:4px 10px; border-radius:6px; font-size:0.75rem; font-weight:700;">Occupied</span></td>
                        <td style="font-size:0.85rem; color:#6b7280;">Free at 4:00 PM</td>
                        <td style="text-align: right; padding-right:1.5rem;">
                            <button class="btn-icon" onclick="openEditModal('R-102', 6, 'Occupied')">✎</button>
                            <button class="btn-icon btn-delete" style="color:#ef4444; border-color:#fee2e2;">🗑️</button>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding-left:1.5rem;"><strong>R-103</strong></td>
                        <td style="color:#6b7280;">4 Pax</td>
                        <td><span style="color:#6b7280; background:#f3f4f6; padding:4px 10px; border-radius:6px; font-size:0.75rem; font-weight:700;">Maintenance</span></td>
                        <td style="font-size:0.85rem; color:#6b7280;">--</td>
                        <td style="text-align: right; padding-right:1.5rem;">
                            <button class="btn-icon" onclick="openEditModal('R-103', 4, 'Maintenance')">✎</button>
                            <button class="btn-icon btn-delete" style="color:#ef4444; border-color:#fee2e2;">🗑️</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="roomEditModal" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Edit Room Details</h3>
            <button class="btn-close" onclick="closeEditModal()">&times;</button>
        </div>
        <form asp-action="UpdateRoom" method="post">
            <input type="hidden" id="modalRoomIdHidden" name="RoomId" />
            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Room Number</label>
                <input type="text" id="modalRoomIdDisplay" class="form-input" readonly style="background-color:#f9fafb;">
            </div>
            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Capacity (Pax)</label>
                <input type="number" id="modalCapacity" name="Capacity" class="form-input">
            </div>
            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Status</label>
                <select id="modalStatus" name="Status" class="form-input">
                    <option value="Available">Available</option>
                    <option value="Occupied">Occupied</option>
                    <option value="Maintenance">Maintenance</option>
                </select>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-action" style="background:#fff; border:1px solid #ddd; color:#333; width:auto; padding:0.5rem 1rem;" onclick="closeEditModal()">Cancel</button>
                <button type="submit" class="btn-save" style="width: auto; margin:0;">Update</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="/js/room.js" asp-append-version="true"></script>
}