@using LibraryManagementSystem.Models
@model RoomUpdatePageVM


@{
    ViewBag.Title = "Edit Category";
}

@section head {
    <link rel="stylesheet" href="/css/room.css" asp-append-version="true" />
}

<div class="toast-container">
    @if (TempData["Success"] != null)
    {
        <div class="toast toast-success" id="autoToast">
            <span>@TempData["Success"]</span>
            <button onclick="this.parentElement.remove()" style="background:none; border:none; color:white; cursor:pointer; font-size:1.2rem;">&times;</button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="toast toast-error" id="autoToast">
            <span>@TempData["Error"]</span>
            <button onclick="this.parentElement.remove()" style="background:none; border:none; color:white; cursor:pointer; font-size:1.2rem;">&times;</button>
        </div>
    }
</div>

<div class="update-page-container">

    <div class="nav-back-bar">
        <a href="/Room" style="text-decoration:none; color:#6b7280; display:inline-flex; align-items:center; gap:6px; font-weight:600; font-size:0.95rem; transition:color 0.2s;">
            <div style="background:white; border:1px solid #e5e7eb; border-radius:6px; padding:4px; display:flex;">
                <img src="~/images/icons/back.svg" />
            </div>
            Back to Dashboard
        </a>
        <span style="font-size:0.85rem; color:#9ca3af;">Category ID: @Model.CategoryDisplay.Id</span>
    </div>

    <div class="panel panel-top">
        <div class="panel-header">
            <h2 class="panel-title" style="display:flex; align-items:center; gap:10px;">
                <span>
                    <img src="~/images/icons/edit_square.svg" />
                </span>
                Edit Category
            </h2>

            <div style="display:flex; gap:10px;">
                <span class="badge badge-success">Active</span>
            </div>
        </div>

        <div class="panel-body">
            <form asp-action="Edit" method="post">

                <div class="form-horizontal-grid">

                    <div class="form-group">
                        <label class="form-label">ID</label>
                        <input asp-for="CategoryUpdate.Id" class="form-input" readonly style="background:#f8fafc; color:#6b7280; font-family:monospace;" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Category Name</label>
                        <input asp-for="CategoryUpdate.Name" class="form-input" style="font-weight:600;" />
                        <span asp-validation-for="CategoryUpdate.Name" class="text-danger" style="font-size:0.8rem; color:var(--danger);"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Hourly Rate</label>
                        <div style="position:relative;">
                            <span style="position:absolute; left:12px; top:10px; color:#9ca3af; font-size:0.9rem;">RM</span>
                            <input asp-for="CategoryUpdate.HourlyRate" class="form-input" type="number" step="0.01" style="padding-left:40px;" />
                        </div>
                        <span asp-validation-for="CategoryUpdate.HourlyRate" class="text-danger" style="font-size:0.8rem; color:var(--danger);"></span>
                    </div>

                    <div class="form-group form-full-width">
                        <label class="form-label">Description & Amenities</label>
                        <textarea asp-for="CategoryUpdate.Description" class="form-input" rows="2"></textarea>
                        <span asp-validation-for="CategoryUpdate.Description" class="text-danger" style="font-size:0.8rem; color:var(--danger);"></span>
                    </div>

                </div>

                <div style="margin-top: 1.5rem; display:flex; justify-content:flex-end; gap:10px; border-top:1px solid #f3f4f6; padding-top:1rem;">
                    <button type="button" class="btn-action" onclick="openDeleteModal('/Room/DeleteCategory/@Model.CategoryUpdate.Id', '@Model.CategoryUpdate.Name')">Delete</button>
                    <button type="submit" class="btn-save" style="width: auto; padding: 0.6rem 2rem; margin:0;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <div class="panel panel-bottom-fill">
        <div class="panel-header">
            <div class="section-title">
                <h2 class="panel-title" style="display:flex; align-items:center; gap:10px;">
                <span>
                <img src="~/images/icons/room.svg" />   
                </span>
                    Associated Rooms
                <span class="badge badge-neutral" style="margin-left:10px;">
                    @Model.CategoryDisplay.Rooms.Count Total
                </span>
                </h2>
                
            </div>
            <button class="btn-save" style="width:auto; padding: 6px 16px; font-size:0.85rem;" onclick="alert('Use the Dashboard to add new rooms!')">+ Add Room</button>
        </div>

        <div class="table-wrapper">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th style="width: 10%;">ID</th>
                        <th style="width: 20%;">Name</th>
                        <th style="width: 20%;">Location</th>
                        <th style="width: 10%;">Capacity</th>
                        <th style="width: 15%;">Status</th>
                        <th style="width: 15%;">Image</th>
                        <th style="width: 10%; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model.CategoryDisplay.Rooms)
                    {
                        <tr>
                            <td><strong>@room.Id</strong></td>
                            <td>@room.Name</td>
                            <td>@room.Location</td>
                            <td style="color:var(--text-body);">@room.Capacity Pax</td>
                            <td>
                                @if (room.Status.ToString() == "AVAILABLE")
                                {
                                    <span class="badge badge-success">Available</span>
                                }
                                else if (room.Status.ToString() == "MAINTENANCE")
                                {
                                    <span class="badge badge-warning">Maintenance</span>
                                }
                                else
                                {
                                    <span class="badge badge-neutral">Occupied</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(room.ImageURL))
                                {
                                    <a href="/images/rooms/@room.ImageURL" target="_blank" style="font-size:0.85rem; color:var(--primary);">View Image</a>
                                }
                                else
                                {
                                    <span style="color:#ccc;">-</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <button class="btn-icon"
                                        onclick="openEditModal('@room.Id', '@room.Name', '@room.Location', @room.Capacity, '@room.Status')">
                                    <img src="~/images/icons/edit.svg" />
                                </button>
                                <button class="btn-icon btn-delete"
                                        onclick="openDeleteModal('/Room/DeleteRoom/@room.Id', '@room.Name')">
                                    <img src="~/images/icons/delete.svg" />
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="roomEditModal" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Edit Room Details</h3>
            <button class="btn-close" onclick="closeEditModal()">&times;</button>
        </div>

        <form asp-action="UpdateRoomDetails" method="post">
            <input type="hidden" id="modalRoomIdHidden" asp-for="RoomUpdate.RoomId" />

            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Room Number</label>
                <input type="text" id="modalRoomIdDisplay" class="form-input" readonly style="background-color:#f9fafb;" value="@Model.RoomUpdate.RoomId">
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Room Name</label>
                <input type="text" id="modalRoomName" asp-for="RoomUpdate.Name" class="form-input" />
                <span asp-validation-for="RoomUpdate.Name" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Location</label>
                <input type="text" id="modalRoomLocation" asp-for="RoomUpdate.Location" class="form-input" />
                <span asp-validation-for="RoomUpdate.Location" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Capacity (Pax)</label>
                <input type="number" id="modalCapacity" asp-for="RoomUpdate.Capacity" class="form-input" />
                <span asp-validation-for="RoomUpdate.Capacity" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Status</label>
                <select id="modalStatus" asp-for="RoomUpdate.Status" class="form-input">
                    <option value="AVAILABLE">Available</option>
                    <option value="MAINTENANCE">Maintenance</option>
                </select>
                <span asp-validation-for="RoomUpdate.Status" class="text-danger"></span>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-action" onclick="closeEditModal()">Cancel</button>
                <button type="submit" class="btn-save" style="width: auto; margin:0;">Update</button>
            </div>
        </form>
    </div>
</div>

<div id="deleteConfirmationModal" class="modal-overlay">
    <div class="modal-box" style="max-width:380px; text-align:center;">

        <div style="color:var(--danger); margin-bottom:1rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </div>

        <h3 style="margin-bottom:0.5rem; color:var(--text-main);">Confirm Deletion</h3>
        <p style="color:var(--text-body); margin-bottom:1.5rem;">
            Are you sure you want to delete <strong id="deleteItemName">Item</strong>?<br>
            <span style="font-size:0.85rem; color:var(--text-muted);">This action cannot be undone.</span>
        </p>

        <form id="deleteForm" method="post">
            <div style="display:flex; justify-content:center; gap:10px;">
                <button type="button" class="btn-action" onclick="closeDeleteModal()">Cancel</button>
                <button type="submit" class="btn-save" style="background-color:var(--danger); width:auto; padding:0.6rem 2rem;">Delete</button>
            </div>
        </form>
    </div>
</div>

@section foot {
    <script src="/js/room.js" asp-append-version="true"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        var shouldOpenModal = @((!ViewData.ModelState.IsValid && ViewData.ModelState.Keys.Any(k => k.StartsWith("RoomUpdate"))).ToString().ToLower());

        if (shouldOpenModal) {
            document.addEventListener("DOMContentLoaded", function() {
                var modal = document.getElementById('roomEditModal');
                if (modal) {
                    modal.style.display = 'block';
                }
            });
        }
    </script>
}