@using LibraryManagementSystem.Models
@model RoomUpdatePageVM

@{
    ViewBag.Title = "Edit Category";
}

@section head {
    <link rel="stylesheet" href="/css/room.css" asp-append-version="true" />
}

<div class="update-page-container">

    <div class="nav-back-bar">
        <a href="/Room" style="text-decoration:none; color:#6b7280; display:inline-flex; align-items:center; gap:6px; font-weight:600; font-size:0.95rem; transition:color 0.2s;">
            <div style="background:white; border:1px solid #e5e7eb; border-radius:6px; padding:4px; display:flex;">
                <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#434343"><path d="m287-446.67 240 240L480-160 160-480l320-320 47 46.67-240 240h513v66.66H287Z" /></svg>
            </div>
            Back to Dashboard
        </a>
        <span style="font-size:0.85rem; color:#9ca3af;">Category ID: @Model.CategoryDisplay.Id</span>
    </div>

    <div class="panel panel-top">
        <div class="panel-header" style="padding: 0.75rem 1.5rem; min-height: auto;">
            <h2 class="panel-title" style="font-size: 1rem;">
                <span><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#0000F5"><path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h357l-80 80H200v560h560v-278l80-80v358q0 33-23.5 56.5T760-120H200Zm280-360ZM360-360v-170l367-367q12-12 27-18t30-6q16 0 30.5 6t26.5 18l56 57q11 12 17 26.5t6 29.5q0 15-5.5 29.5T897-728L530-360H360Zm481-424-56-56 56 56ZM440-440h56l232-232-28-28-29-28-231 231v57Zm260-260-29-28 29 28 28 28-28-28Z" /></svg></span>
                Edit Category
            </h2>
            <div class="form-actions" style="margin:0; padding:0; border:none; gap:10px;">
                <button type="button" class="btn-action" style="padding: 4px 12px; font-size: 0.8rem; color:#ef4444; border-color:#ef4444;"
                        onclick="openDeleteModal('/Room/DeleteCategory/@Model.CategoryUpdate.Id', '@Model.CategoryUpdate.Name')">
                    Delete
                </button>

                <button type="button" class="btn-save" style="width: auto; padding: 4px 16px; font-size: 0.8rem;" onclick="document.getElementById('editForm').submit();">Save Changes</button>
            </div>
        </div>

        <div class="panel-body" style="padding: 1.25rem;">
            <form id="editForm" asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="CategoryUpdate.ExistingImageURL" />

                <div class="layout-horizontal-card">

                    <div class="layout-left-img">
                        <div class="img-preview-box">
                            @if (!string.IsNullOrEmpty(Model.CategoryUpdate.ExistingImageURL))
                            {
                                <img src="/images/categories/@Model.CategoryUpdate.ExistingImageURL" />
                            }
                            else
                            {
                                <div class="no-img">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                                    <span>No Image</span>
                                </div>
                            }
                        </div>
                        <input id="imgUpload" asp-for="CategoryUpdate.Image" type="file" accept="image/*" style="display:none;" onchange="document.getElementById('editForm').submit();" />
                        <label for="imgUpload" class="btn-upload-overlay">Change Image</label>
                    </div>

                    <div class="layout-right-form">

                        <div class="form-row-compact">
                            <div>
                                <label class="lbl-sm">ID</label>
                                <input asp-for="CategoryUpdate.Id" class="form-input" readonly style="background:#f8fafc; color:#94a3b8; text-align:center; padding: 6px;" />
                            </div>
                            <div>
                                <label class="lbl-sm">Rate (RM/Hr)</label>
                                <input asp-for="CategoryUpdate.HourlyRate" class="form-input" type="number" step="0.01" style="padding: 6px;" data-trim />
                                <span asp-validation-for="CategoryUpdate.HourlyRate" class="text-danger"></span>
                            </div>
                            <div>
                                <label class="lbl-sm">Category Name</label>
                                <input asp-for="CategoryUpdate.Name" class="form-input" style="font-weight:600; padding: 6px;" data-trim />
                                <span asp-validation-for="CategoryUpdate.Name" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-row-desc">
                            <label class="lbl-sm">Description & Amenities</label>
                            <textarea asp-for="CategoryUpdate.Description" class="form-input desc-textarea" placeholder="Describe amenities..." data-trim></textarea>
                            <span asp-validation-for="CategoryUpdate.Description" class="text-danger"></span>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="panel panel-bottom-fill">
        <div class="panel-header" style="padding: 0.75rem 1.5rem; min-height: auto;">
            <div class="section-title">
                <h2 class="panel-title" style="font-size: 1rem;">
                    <span><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#0000F5"><path d="M120-120v-80h80v-640h400v40h160v600h80v80H680v-600h-80v600H120Zm160-640v560-560Zm160 320q17 0 28.5-11.5T480-480q0-17-11.5-28.5T440-520q-17 0-28.5 11.5T400-480q0 17 11.5 28.5T440-440ZM280-200h240v-560H280v560Z" /></svg></span>
                    Associated Rooms
                    <span class="badge badge-neutral" style="margin-left:8px; font-size:0.75rem;">@Model.CategoryDisplay.Rooms.Count</span>
                </h2>
            </div>
            <button class="btn-save" type="button" style="width:auto; padding: 4px 12px; font-size:0.8rem;" onclick="openAddRoomModal()">
                + Add Room
            </button>
        </div>

        <div class="table-wrapper">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th style="width: 15%;">ID</th>
                        <th style="width: 25%;">Name</th>
                        <th style="width: 25%;">Location</th>
                        <th style="width: 10%;">Capacity</th>
                        <th style="width: 15%;">Status</th>
                        <th style="width: 10%; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model.CategoryDisplay.Rooms)
                    {
                        <tr>
                            <td><strong>@room.Id</strong></td>
                            <td>@room.Name</td>
                            <td>@room.Location</td>
                            <td style="color:var(--text-body);">@room.Capacity Pax</td>
                            <td>
                                @if (room.Status.ToString() == "AVAILABLE")
                                {
                                    <span class="badge badge-success">Available</span>
                                }
                                else if (room.Status.ToString() == "MAINTENANCE")
                                {

                                    <span class="badge badge-warning">Maintenance</span>
                                }
                                else
                                {

                                    <span class="badge badge-neutral">Occupied</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <button class="btn-icon" type="button" onclick="openEditModal('@room.Id', '@room.Name', '@room.Location', @room.Capacity, '@room.Status')">
                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#666666"><path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z" /></svg>
                                </button>
                                <button class="btn-icon btn-delete" type="button" onclick="openDeleteModal('/Room/DeleteRoom/@room.Id', '@room.Name')">
                                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#666666"><path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z" /></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="roomEditModal" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Edit Room Details</h3>
            <button class="btn-close" onclick="closeEditModal()">&times;</button>
        </div>
        <form asp-action="UpdateRoomDetails" method="post">
            <input type="hidden" id="modalRoomIdHidden" asp-for="RoomUpdate.RoomId" />
            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Room Number</label>
                <input type="text" id="modalRoomIdDisplay" class="form-input" readonly style="background-color:#f9fafb;" value="@Model.RoomUpdate.RoomId">
            </div>
            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Room Name</label>
                <input type="text" id="modalRoomName" asp-for="RoomUpdate.Name" class="form-input" data-trim />
                <span asp-validation-for="RoomUpdate.Name" class="text-danger"></span>
            </div>
            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Location</label>
                <input type="text" id="modalRoomLocation" asp-for="RoomUpdate.Location" class="form-input" data-trim />
                <span asp-validation-for="RoomUpdate.Location" class="text-danger"></span>
            </div>
            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Capacity (Pax)</label>
                <input type="number" id="modalCapacity" asp-for="RoomUpdate.Capacity" class="form-input" />
                <span asp-validation-for="RoomUpdate.Capacity" class="text-danger"></span>
            </div>
            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Status</label>
                <select id="modalStatus" asp-for="RoomUpdate.Status" class="form-input">
                    <option value="AVAILABLE">Available</option>
                    <option value="MAINTENANCE">Maintenance</option>
                </select>
                <span asp-validation-for="RoomUpdate.Status" class="text-danger"></span>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-action" onclick="closeEditModal()">Cancel</button>
                <button type="submit" class="btn-save" style="width: auto; margin:0;">Update</button>
            </div>
        </form>
    </div>
</div>

<div id="deleteConfirmationModal" class="modal-overlay">
    <div class="modal-box" style="max-width:380px; text-align:center;">
        <div style="color:var(--danger); margin-bottom:1rem;">
            <svg xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="#EA3323"><path d="M479.99-280q15.01 0 25.18-10.15 10.16-10.16 10.16-25.17 0-15.01-10.15-25.18-10.16-10.17-25.17-10.17-15.01 0-25.18 10.16-10.16 10.15-10.16 25.17 0 15.01 10.15 25.17Q464.98-280 479.99-280Zm-31.32-155.33h66.66V-684h-66.66v248.67ZM480.18-80q-82.83 0-155.67-31.5-72.84-31.5-127.18-85.83Q143-251.67 111.5-324.56T80-480.33q0-82.88 31.5-155.78Q143-709 197.33-763q54.34-54 127.23-85.5T480.33-880q82.88 0 155.78 31.5Q709-817 763-763t85.5 127Q880-563 880-480.18q0 82.83-31.5 155.67Q817-251.67 763-197.46q-54 54.21-127 85.84Q563-80 480.18-80Zm.15-66.67q139 0 236-97.33t97-236.33q0-139-96.87-236-96.88-97-236.46-97-138.67 0-236 96.87-97.33 96.88-97.33 236.46 0 138.67 97.33 236 97.33 97.33 236.33 97.33ZM480-480Z" /></svg>
        </div>
        <h3 style="margin-bottom:0.5rem; color:var(--text-main);">Confirm Deletion</h3>
        <p style="color:var(--text-body); margin-bottom:1.5rem;">
            Are you sure you want to delete <strong id="deleteItemName">Item</strong>?<br>
            <span style="font-size:0.85rem; color:var(--text-muted);">This action cannot be undone.</span>
        </p>
        <form id="deleteForm" method="post">
            <div style="display:flex; justify-content:center; gap:10px;">
                <button type="button" class="btn-action" onclick="closeDeleteModal()">Cancel</button>
                <button type="submit" class="btn-save" style="background-color:var(--danger); width:auto; padding:0.6rem 2rem;">Delete</button>
            </div>
        </form>
    </div>
</div>

<div id="addRoomModal" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Add New Room</h3>
            <button class="btn-close" type="button" onclick="closeAddRoomModal()">&times;</button>
        </div>

        <form asp-action="CreateRoomFromEdit" method="post">

            <input type="hidden" asp-for="CategoryUpdate.Id" />

            <input type="hidden" asp-for="RoomUpdate.Status" value="AVAILABLE" />

            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Room Name</label>
                <input asp-for="RoomUpdate.Name" id="add_room_name" class="form-input" placeholder="e.g. Room A" data-trim />
                <span asp-validation-for="RoomUpdate.Name" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Location</label>
                <input asp-for="RoomUpdate.Location" id="add_room_location" class="form-input" placeholder="e.g. Level 1" data-trim />
                <span asp-validation-for="RoomUpdate.Location" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
                <label class="form-label">Capacity (Pax)</label>
                <input asp-for="RoomUpdate.Capacity" id="add_room_capacity" class="form-input" placeholder="0" />
                <span asp-validation-for="RoomUpdate.Capacity" class="text-danger"></span>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-action" onclick="closeAddRoomModal()">Cancel</button>
                <button type="submit" class="btn-save" style="width: auto; margin:0;">Create Room</button>
            </div>
        </form>
    </div>
</div>

@section foot {
    <script src="/js/room.js" asp-append-version="true"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        var hasErrors = '@((!ViewData.ModelState.IsValid && ViewData.ModelState.Keys.Any(k => k.StartsWith("RoomUpdate"))).ToString().ToLower())' === 'true';

        var activeModalId = '@ViewData["ActiveModal"]';
        if (hasErrors && activeModalId) {
            document.addEventListener("DOMContentLoaded", function() {
                var modal = document.getElementById(activeModalId);
                if (modal) {
                    modal.style.display = 'block';
                }
            });
        }

        $(document).ready(function () {
            @if (TempData["Success"] != null)
            {
                        <text>
                            showToast('@TempData["Success"]', 'success');
                        </text>
            }

            @if (TempData["Error"] != null)
            {
                        <text>
                            showToast('@TempData["Error"]', 'error');
                        </text>
            }

            @if (!ViewData.ModelState.IsValid && TempData["Error"] == null)
            {
                        <text>
                            showToast('Please check input fields.', 'error');
                        </text>
            }
        });
    </script>
}