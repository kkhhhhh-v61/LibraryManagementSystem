@using LibraryManagementSystem.Models
@model RoomIndexVM

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

<form asp-action="CreateCategoryAjax" method="post"
      data-ajax="true"
      data-ajax-method="post"
      data-ajax-update="#createCategoryContainer"
      data-ajax-loading="#catLoader"
      class="form-stack" enctype="multipart/form-data">

    <div class="form-group">
        <label class="form-label">Name</label>
        <input asp-for="CategoryInput.Name" class="form-input" placeholder="e.g. Gaming Room" data-trim autofocus/>
        <span asp-validation-for="CategoryInput.Name" class="text-danger" style="font-size:0.8rem; color:var(--danger);"></span>
    </div>

    <div class="form-group">
        <label class="form-label">Rate (RM/Hr)</label>
        <input asp-for="CategoryInput.HourlyRate" class="form-input" placeholder="0.00" type="number" step="0.01" data-trim />
        <span asp-validation-for="CategoryInput.HourlyRate" class="text-danger" style="font-size:0.8rem; color:var(--danger);"></span>
    </div>

    <div class="form-group">
        <label class="form-label">Description</label>
        <textarea asp-for="CategoryInput.Description" class="form-input" rows="2" data-trim></textarea>
        <span asp-validation-for="CategoryInput.Description" class="text-danger" style="font-size:0.8rem; color:var(--danger);"></span>
    </div>

    <div class="form-group">
        <label class="form-label">Image</label>
        <input asp-for="CategoryInput.Image" id="categoryImgInput" class="form-input" type="file" accept="image/*" />
        <span asp-validation-for="CategoryInput.Image" class="text-danger" style="font-size:0.8rem; color:var(--danger);"></span>
    </div>

    <div style="display:flex; justify-content:space-between; align-items:center;">
        <button type="submit" class="btn-save">Create Category</button>
        <div id="catLoader" class="loading-spinner" style="display:none;"></div>
    </div>
</form>

<div id="cropperModal" class="modal-overlay" style="display:none; z-index: 9999;">
    <div class="modal-box" style="width: 90%; max-width: 600px;">
        <div class="modal-header">
            <h3>Crop Image</h3>
            <button type="button" class="btn-close" onclick="closeCropperModal()">&times;</button>
        </div>
        <div class="modal-body">
            <div class="img-container">
                <img id="imageToCrop" src="" alt="Picture to crop">
            </div>
        </div>
        <div class="modal-actions" style="margin-top: 15px; justify-content: flex-end;">
            <button type="button" class="btn-action" onclick="closeCropperModal()">Cancel</button>
            <button type="button" class="btn-save" id="btnCropConfirm">Crop & Save</button>
        </div>
    </div>
</div>

@if (ViewData["SuccessMessage"] != null)
{
    <script>
        showToast('@ViewData["SuccessMessage"]', 'success');

        if (typeof submitSearch === 'function') {
            submitSearch();
        }

        var newId = '@ViewData["NewCategoryId"]';
        var newName = '@ViewData["NewCategoryName"]';

        var dropdown = document.getElementById("RoomInput_RoomCategoryId");

        if (dropdown && newId && newName) {
            var newOption = new Option(newName, newId);

            dropdown.add(newOption);

            dropdown.style.transition = "background-color 0.5s";
            dropdown.style.backgroundColor = "#dcfce7";
            setTimeout(() => {
                dropdown.style.backgroundColor = "";
            }, 1000);
        }
    </script>
}