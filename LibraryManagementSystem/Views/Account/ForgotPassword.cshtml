@model LibraryManagementSystem.Models.ForgotPasswordVM

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-header">
            <div class="auth-title">Forgot Password?</div>
            <div class="auth-subtitle">Enter your email and we'll send you a reset link</div>
        </div>

        <form asp-action="ForgotPassword" id="forgotPasswordForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="auth-group">
                <label asp-for="Email" class="auth-label">Email Address</label>
                <input asp-for="Email" class="auth-input" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <button type="submit" class="auth-btn">Send Reset Link</button>

            <div class="auth-footer">
                Remember your password? <a asp-action="Login">Login here</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('#forgotPasswordForm').on('submit', function (e) {
                if ($(this).valid()) {
                    if (window.showToast) {
                        window.showToast("Sending reset link... Please wait.", "info");
                    }
                }
            });
        });
    </script>
}