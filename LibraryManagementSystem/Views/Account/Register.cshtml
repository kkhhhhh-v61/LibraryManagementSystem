@model LibraryManagementSystem.Models.RegisterVM

@{
    ViewData["Title"] = "Register";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="auth-title">Create Account</h1>
            <p class="auth-subtitle">Start your journey with BookBase.</p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="auth-group">
                <label asp-for="Username" class="auth-label">Username</label>
                <input asp-for="Username" class="auth-input" placeholder="Choose a username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="auth-group">
                <label asp-for="Email" class="auth-label">Email Address</label>
                <input asp-for="Email" type="email" class="auth-input" placeholder="name@company.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="auth-group">
                <label asp-for="Password" class="auth-label">Password</label>
                <input asp-for="Password" type="password" class="auth-input" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="auth-group">
                <label asp-for="ConfirmPassword" class="auth-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="auth-input" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="auth-btn">Create Account</button>
        </form>

        <div class="auth-footer">
            Already have an account? <a asp-controller="Account" asp-action="Login">Log in</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}