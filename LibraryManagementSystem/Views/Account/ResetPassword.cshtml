@model LibraryManagementSystem.Models.ResetPasswordVM

@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-header">
            <div class="auth-title">Reset Password</div>
            <div class="auth-subtitle">Please create a new password for your account</div>
        </div>

        <form asp-action="ResetPassword">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div class="auth-group">
                <label asp-for="Password" class="auth-label">New Password</label>

                <div class="password-wrapper">
                    <input asp-for="Password" class="auth-input" type="password" id="newPassword" placeholder="Enter new password" autofocus/>

                    <i class="fa-solid fa-eye password-toggle"
                       onclick="togglePassword('newPassword', this)"></i>
                </div>
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div class="auth-group">
                <label asp-for="ConfirmPassword" class="auth-label">Confirm Password</label>

                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" class="auth-input" type="password" id="confirmPassword" placeholder="Confirm new password" />

                    <i class="fa-solid fa-eye password-toggle"
                       onclick="togglePassword('confirmPassword', this)"></i>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <input type="submit" value="Reset Password" class="auth-btn" />

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}