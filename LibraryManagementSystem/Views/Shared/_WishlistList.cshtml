@model List<Wishlist>

<div class="notification-header">
    <span class="notification-title">My Wishlist (@Model.Count)</span>
</div>

<div class="notification-list">
    @if (Model == null || !Model.Any())
    {
        <div class="header-dropdown__empty">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" /></svg>
            <span>Your wishlist is empty.</span>
        </div>
    }
    else
    {
        foreach (var item in Model)
        {
            <a href="@Url.Action("BookDetails", "Book", new { id = item.BookId })" class="wishlist-item">
                <img src="@(string.IsNullOrEmpty(item.Book.ImageURL) ? "/images/assets/no-cover.jpg" : $"/images/books/{item.Book.ImageURL}")" class="wishlist-cover" alt="@item.Book.Title" />
                <div class="wishlist-info">
                    <p class="wishlist-title">@item.Book.Title</p>
                    <p class="wishlist-author">
                        @string.Join(", ", item.Book.Authors.Select(a => a.Name))
                    </p>
                </div>
            </a>
        }
    }
</div>