@model List<Wishlist>

<div class="notification-header">
    <span class="notification-title">My Wishlist</span>
</div>

@if (Model == null || !Model.Any())
{
    <div class="header-dropdown__empty">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="currentColor">
            <path d="m480-120-58-52q-101-91-167-157T150-447.5Q111-500 95.5-544T80-634q0-94 63-157t157-63q52 0 99 22t81 62q34-40 81-62t99-22q94 0 157 63t63 157q0 46-15.5 90T810-447.5Q771-395 705-329T538-172l-58 52Zm0-108q96-86 158-147.5t98-107q36-45.5 50-81t14-70.5q0-60-40-100t-100-40q-47 0-87 26.5T518-680h-76q-28-41-68-67.5T287-774q-60 0-100 40t-40 100q0 35 14 70.5t50 81q36 45.5 98 107T480-228Zm0-273Z"/>
        </svg>
        <span>Your wishlist is empty</span>
    </div>
}
else
{
    <div class="notification-list">
        @foreach (var item in Model)
        {
            <div class="wishlist-item">
                <a href="@Url.Action("BookDetails", "Book", new { id = item.BookId })" style="display: flex; gap: 16px; text-decoration: none; flex: 1; color: inherit;">
                    <img src="@(string.IsNullOrEmpty(item.Book.ImageURL) ? "/images/assets/no-cover.jpg" : $"/images/books/{item.Book.ImageURL}")" class="wishlist-cover" alt="@item.Book.Title" />
                    <div style="flex: 1;">
                        <div class="wishlist-title">@item.Book.Title</div>
                        <div class="wishlist-author">
                            @string.Join(", ", item.Book.Authors.Select(a => a.Name))
                        </div>
                    </div>
                </a>
                <button class="notification-action-btn notification-action-btn--danger" 
                        onclick="removeFromWishlist(event, '@item.BookId')" 
                        title="Remove from Wishlist">
                    <svg xmlns="http://www.w3.org/2000/svg" height="20" viewBox="0 -960 960 960" width="20" fill="currentColor">
                        <path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/>
                    </svg>
                </button>
            </div>
        }
    </div>
}