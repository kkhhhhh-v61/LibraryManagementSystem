<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>@ViewBag.Title | Open LMS</title> 
        <link rel="icon" type="image/x-icon" href="/images/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap">
        <link rel="stylesheet" href="/css/app.css" asp-append-version="true"/>
        @RenderSection("head", false)
    </head>
    <body>
        <header>
            <a href="/" id="logo">
                <img src="/images/favicon.svg" alt="Logo" />
                <h1>Open LMS</h1>
            </a>
        </header>

        <main>
            @RenderBody()
        </main>

        <footer>
            <p>Copyright &copy; Library Management System. @DateTime.Now.Year. All Rights Reserved.</p>
        </footer>

        <script src="jquery.min.js">
        <script src="jquery.unobtrusive-ajax.min.js"></script>
        <script src="jquery.validate.min.js"></script>
        <script src="jquery.validate.unobtrusive.min.js"></script>
        <script src="/js/app.js" asp-append-version="true"></script>
        @RenderSection("foot", false)
    </body>
</html>