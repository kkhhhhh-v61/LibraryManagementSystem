<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>@ViewBag.Title | @ViewBag.System</title> 
        <link rel="icon" type="image/x-icon" href="/images/icons/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap">
        <link rel="stylesheet" href="/css/app.css" asp-append-version="true"/>
        @RenderSection("head", false)
    </head>
    <body>
        <header>
            <a href="/" id="logo">
                <img src="/images/icons/favicon.svg" alt="Logo" />
                <h1>@ViewBag.System</h1>
            </a>

            <nav id="main-nav">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/">Catalogue</a></li>
                    <li><a href="/">Facility</a></li>
                </ul>
            </nav>

            <nav id="util-nav">
                <div class="util-item">
                    <img src="/images/icons/shelf.svg" alt="Shelf" />
                    @* <span class="badge">0</span> *@
                </div>
                <div class="util-item">
                    <img src="/images/icons/basket.svg" alt="Basket" />
                    @* <span class="badge">0</span> *@
                </div>
                <div id="profile-dropdown" class="util-item">
                    <img src="/images/icons/profile.svg" alt="Profile" />
                    <ul class="dropdown-menu">
                        <li><a href="/"><img src="/images/icons/login.svg" alt="" />Log In</a></li>
                        <li class="separator"></li>
                        <li><a href="/"><img src="/images/icons/register.svg" alt="" />Register</a></li>
                    </ul>
                </div>
            </nav>
        </header>

        <main>
            <div class="main-content-wrapper">
                @RenderBody()
            </div>
        </main>

        <footer>
            <p>Copyright &copy; <a href="/">@ViewBag.System</a>. @DateTime.Now.Year. All Rights Reserved.</p>
        </footer>

        <script src="jquery.min.js">
        <script src="jquery.unobtrusive-ajax.min.js"></script>
        <script src="jquery.validate.min.js"></script>
        <script src="jquery.validate.unobtrusive.min.js"></script>
        <script src="/js/app.js" asp-append-version="true"></script>
        @RenderSection("foot", false)
    </body>
</html>