<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>@ViewBag.Title | @ViewBag.System</title> 
        <link rel="icon" type="image/x-icon" href="/images/icons/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap">
        <link rel="stylesheet" href="/css/app.css" asp-append-version="true"/>
        <link rel="stylesheet" href="/css/room.css" asp-append-version="true" />
        @RenderSection("head", false)
    </head>
    <body>
        <header class="site-header">
            <a href="/" class="logo">
                <img class="logo__image" src="/images/icons/favicon.svg" alt="Logo" />
                <h1 class="logo__text">@ViewBag.System</h1>
            </a>

            <nav class="main-nav">
                <ul class="main-nav__list">
                    <li class="main-nav__item"><a class="main-nav__link" href="/">Home</a></li>
                    <li class="main-nav__item"><a class="main-nav__link" href="/">Catalogue</a></li>
                    <li class="main-nav__item"><a class="main-nav__link" href="/">Facility</a></li>
                    <li class="main-nav__item"><a class="main-nav__link" asp-controller="RoomCategories" asp-action="Index">Room Setup</a></li>
                    <li class="main-nav__item"><a class="main-nav__link" asp-controller="RoomBooking" asp-action="StaffDashboard">Staff Dashboard</a></li>
                </ul>
            </nav>

            <nav class="util-nav">
                <div class="util-nav__item">
                    <img class="util-nav__icon" src="/images/icons/shelf.svg" alt="Shelf" />
                    @* <span class="badge">0</span> *@
                </div>
                <div class="util-nav__item">
                    <img class="util-nav__icon" src="/images/icons/basket.svg" alt="Basket" />
                    @* <span class="badge">0</span> *@
                </div>
                <div class="util-nav__item">
                    <img class="util-nav__icon" src="/images/icons/profile.svg" alt="Profile" />
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-menu__link" href="/"><img class="dropdown-menu__icon" src="/images/icons/login.svg" alt="" />Log In</a></li>
                        <li class="dropdown-menu__separator"></li>
                        <li><a class="dropdown-menu__link" href="/"><img class="dropdown-menu__icon" src="/images/icons/register.svg" alt="" />Register</a></li>
                    </ul>
                </div>
            </nav>
        </header>

        <main class="main-content">
            <div class="main-content-wrapper">
                @RenderBody()
            </div>
        </main>

        <footer class="site-footer">
            <p class="site-footer__text">Copyright &copy; <a class="site-footer__link" href="/">@ViewBag.System</a>. @DateTime.Now.Year. All Rights Reserved.</p>
        </footer>

        <script src="jquery.min.js">
        <script src="jquery.unobtrusive-ajax.min.js"></script>
        <script src="jquery.validate.min.js"></script>
        <script src="jquery.validate.unobtrusive.min.js"></script>
        <script src="/js/app.js" asp-append-version="true"></script>
        @RenderSection("foot", false)
    </body>
</html>