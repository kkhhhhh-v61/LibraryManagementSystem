<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title | @ViewBag.System</title>
    <link rel="icon" type="image/x-icon" href="/images/icons/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sansation:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap">
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true" />
    @RenderSection("head", false)
</head>

<body>
    <nav class="layout__sidebar" id="sidebar">
        <a href="/" class="logo">
            <img src="/images/icons/logo.svg" alt="Logo" class="logo__image" />
            <span class="logo__text"><b>Book</b>Base</span>
        </a>

        <div class="sidebar-nav">
            <div class="sidebar-nav__group">
                <a asp-controller="Home" asp-action="Index" class="sidebar-nav__link @Html.IsActive("Home", null, "sidebar-nav__link--active")">
                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000" class="sidebar-nav__icon">
                        <path d="M240-200h120v-240h240v240h120v-360L480-740 240-560v360Zm-80 80v-480l320-240 320 240v480H520v-240h-80v240H160Zm320-350Z"/>
                    </svg>
                    <span class="sidebar-nav__text">Home</span>
                </a>

                <div class="sidebar-nav__item">
                    <a asp-controller="Book" asp-action="Browse" class="sidebar-nav__link @Html.IsActive("Book", null, "sidebar-nav__link--active")">
                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000" class="sidebar-nav__icon">
                            <path d="M560-564v-68q33-14 67.5-21t72.5-7q26 0 51 4t49 10v64q-24-9-48.5-13.5T700-600q-38 0-73 9.5T560-564Zm0 220v-68q33-14 67.5-21t72.5-7q26 0 51 4t49 10v64q-24-9-48.5-13.5T700-380q-38 0-73 9t-67 27Zm0-110v-68q33-14 67.5-21t72.5-7q26 0 51 4t49 10v64q-24-9-48.5-13.5T700-490q-38 0-73 9.5T560-454ZM260-320q47 0 91.5 10.5T440-278v-394q-41-24-87-36t-93-12q-36 0-71.5 7T120-692v396q35-12 69.5-18t70.5-6Zm260 42q44-21 88.5-31.5T700-320q36 0 70.5 6t69.5 18v-396q-33-14-68.5-21t-71.5-7q-47 0-93 12t-87 36v394Zm-40 118q-48-38-104-59t-116-21q-42 0-82.5 11T100-198q-21 11-40.5-1T40-234v-482q0-11 5.5-21T62-752q46-24 96-36t102-12q58 0 113.5 15T480-740q51-30 106.5-45T700-800q52 0 102 12t96 36q11 5 16.5 15t5.5 21v482q0 23-19.5 35t-40.5 1q-37-20-77.5-31T700-240q-60 0-116 21t-104 59ZM280-494Z"/>
                        </svg>
                        <span class="sidebar-nav__text">Catalogue</span>
                        <svg class="sidebar-nav__arrow" xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#999">
                            <path d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"/>
                        </svg>
                    </a>

                    <div class="sidebar-subnav">
                        <a href="#" class="sidebar-subnav__link">Browse All</a>
                        <a href="#" class="sidebar-subnav__link">New Arrivals</a>
                        <a href="#" class="sidebar-subnav__link">Genres</a>

                        <div class="sidebar-subnav__separator"></div>

                        <a asp-controller="Book" asp-action="Insert" class="sidebar-subnav__link @Html.IsActive("Book", "Insert", "sidebar-subnav__link--active")">Insert Book</a>
                    </div>
                </div>

                <div class="sidebar-nav__item">
                    <a asp-controller="Room" asp-action="Index" class="sidebar-nav__link @Html.IsActive("Room", null, "sidebar-nav__link--active")">
                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000" class="sidebar-nav__icon">
                            <path d="M120-120v-80h80v-640h400v40h160v600h80v80H680v-600h-80v600H120Zm160-640v560-560Zm160 320q17 0 28.5-11.5T480-480q0-17-11.5-28.5T440-520q-17 0-28.5 11.5T400-480q0 17 11.5 28.5T440-440ZM280-200h240v-560H280v560Z"/>
                        </svg>
                        <span class="sidebar-nav__text">Room</span>
                    </a>

                </div>

                <div class="sidebar-nav__item">
                    <a asp-controller="Booking" asp-action="Index" class="sidebar-nav__link @Html.IsActive("Booking", null, "sidebar-nav__link--active")">
                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000" class="sidebar-nav__icon">
                            <path d="M120-120v-80h80v-640h400v40h160v600h80v80H680v-600h-80v600H120Zm160-640v560-560Zm160 320q17 0 28.5-11.5T480-480q0-17-11.5-28.5T440-520q-17 0-28.5 11.5T400-480q0 17 11.5 28.5T440-440ZM280-200h240v-560H280v560Z" />
                        </svg>
                        <span class="sidebar-nav__text">Booking</span>
                        <svg class="sidebar-nav__arrow" xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#999">
                            <path d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z" />
                        </svg>
                    </a>

                    <div class="sidebar-subnav">
                        <a asp-controller="Booking" asp-action="Index" class="sidebar-subnav__link @Html.IsActive("Booking", "Index", "sidebar-subnav__link--active")">Index</a>

                        <div class="sidebar-subnav__separator"></div>

                        <a asp-controller="Booking" asp-action="StaffDashboard" class="sidebar-subnav__link @Html.IsActive("Booking", "StaffDashboard", "sidebar-subnav__link--active")">Staff Dashboard</a>
                    </div>
                </div>

                
            </div>

            <div class="sidebar-nav__separator"></div>

            <div class="sidebar-nav__group">
                <a href="#" class="sidebar-nav__link sidebar-nav__link--logout">
                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000" class="sidebar-nav__icon">
                        <path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h280v80H200Zm440-160-55-58 102-102H360v-80h327L585-622l55-58 200 200-200 200Z"/>
                    </svg>
                    <span class="sidebar-nav__text">Logout</span>
                </a>
            </div>
        </div>
    </nav>

    <div class="layout__main">
        <header class="layout__header header-main">
            <div class="header-main__search-box">
                <form class="header-main__search-bar">
                    <svg class="header-main__search-icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#999">
                        <path d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/>
                    </svg>
                    <input type="text" name="q" class="header-main__search-input" placeholder="Search for books..." autocomplete="off" />
                </form>
            </div>

            <div class="header-main__actions">
                <div class="header-main__user-profile">
                    <div class="header-main__user-info">
                        <span class="header-main__user-name">User Name</span>
                        <small class="header-main__user-role">Role</small>
                    </div>
                    <img src="/images/assets/default-profile.png" alt="User" class="header-main__user-avatar" />
                </div>
            </div>
        </header>

        <main class="layout__content">
            @RenderBody()
        </main>
    </div>

    <script src="/js/jquery.min.js" asp-append-version="true"></script>
    <script src="/js/jquery.unobtrusive-ajax.min.js" asp-append-version="true"></script>
    <script src="/js/jquery.validate.min.js" asp-append-version="true"></script>
    <script src="/js/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
    <script src="/js/app.js" asp-append-version="true"></script>
    @RenderSection("foot", false)

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>