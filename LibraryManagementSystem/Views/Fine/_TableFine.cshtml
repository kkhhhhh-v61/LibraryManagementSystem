@model FineManagementVM

<table class="table">
    <thead>
        <tr class="table__header">
            @if (User.IsInRole("ADMIN"))
            {
                <th class="table__cell table__cell--checkbox">
                    <input class="checkbox-styled" id="selectAll" type="checkbox" />
                </th>
            }
            <th class="table__cell sortable-header @(Model.SortColumn == "Id" ? "active" : "")" data-sort="Id" data-order="@(Model.SortColumn == "Id" ? Model.SortOrder : "asc")" style="width: 80px;">
                ID
                @if (Model.SortColumn == "Id")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "User" ? "active" : "")" data-sort="User" data-order="@(Model.SortColumn == "User" ? Model.SortOrder : "asc")">
                User
                @if (Model.SortColumn == "User")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell" style="min-width: 200px;">Book</th>
            <th class="table__cell sortable-header @(Model.SortColumn == "Amount" ? "active" : "")" data-sort="Amount" data-order="@(Model.SortColumn == "Amount" ? Model.SortOrder : "asc")" style="width: 120px;">
                Amount
                @if (Model.SortColumn == "Amount")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "IssuedDate" ? "active" : "")" data-sort="IssuedDate" data-order="@(Model.SortColumn == "IssuedDate" ? Model.SortOrder : "asc")" style="width: 150px;">
                Issued
                @if (Model.SortColumn == "IssuedDate")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell sortable-header @(Model.SortColumn == "Status" ? "active" : "")" data-sort="Status" data-order="@(Model.SortColumn == "Status" ? Model.SortOrder : "asc")" style="width: 120px;">
                Status
                @if (Model.SortColumn == "Status")
                {
                    <span class="sort-icon">@(Model.SortOrder == "asc" ? "▲" : "▼")</span>
                }
            </th>
            <th class="table__cell table__cell--actions" style="width: 100px; text-align: center;">Action</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Fines.Any())
        {
            <tr class="table__row">
                <td class="table__cell" colspan="@(User.IsInRole("ADMIN") ? "8" : "7")" style="text-align:center; color: var(--color-gray-500);">
                    No fines found.
                </td>
            </tr>
        }
        else 
        {
            @foreach (var fine in Model.Fines)
            {
                <tr class="table__row">
                    @{
                        bool canDelete = Model.CanDelete.ContainsKey(fine.Id) && Model.CanDelete[fine.Id];
                    }
                    @if (User.IsInRole("ADMIN"))
                    {
                        <td class="table__cell table__cell--checkbox">
                            @if (canDelete)
                            {
                                <input class="row-checkbox checkbox-styled" type="checkbox" name="ids" value="@fine.Id" data-name="@fine.Id" />
                            }
                            else
                            {
                                <input class="checkbox-styled" type="checkbox" disabled style="opacity: 0.5; cursor: not-allowed;" />
                            }
                        </td>
                    }
                    <td class="table__cell table__cell--id">@fine.Id</td>
                    <td class="table__cell">
                        <div style="display: flex; flex-direction: column;">
                            <span style="font-weight: 600; color: var(--color-gray-900);">@fine.Loan.User.Username</span>
                            <span style="font-size: 0.8rem; color: var(--color-gray-500);">@fine.Loan.UserId</span>
                        </div>
                    </td>
                    <td class="table__cell">@fine.Loan.Copy.Book.Title</td>
                    <td class="table__cell" style="font-weight: 600;">RM @fine.Amount.ToString("F2")</td>
                    <td class="table__cell">@fine.IssuedDate.ToString("yyyy-MM-dd")</td>
                    <td class="table__cell">
                        @if (fine.IsPaid) { <span class="status-badge status-available">Paid</span> }
                        else { <span class="status-badge status-unavailable">Unpaid</span> }
                    </td>
                    <td class="table__cell table__cell--actions">
                        <div class="table__actions">
                            @if (!fine.IsPaid)
                            {
                                <form asp-action="MarkFinePaid" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@fine.Id" />
                                    <button class="action__button action__button--add" title="Mark as Paid" type="submit">
                                        <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z"/></svg>
                                    </button>
                                </form>
                            }
                            @if (User.IsInRole("ADMIN"))
                            {
                                <button class="action__button action__button--delete js-delete-trigger"
                                        data-id="@fine.Id"
                                        data-name="@fine.Id"
                                        title="@(canDelete ? "Delete" : "Cannot delete")"
                                        type="button"
                                        @(canDelete ? "" : "disabled style=opacity:0.5;cursor:not-allowed;")>
                                    <svg class="button__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/></svg>
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @if (Model.CurrentPage > 1) { <button class="pagination__link" type="button" data-page="@(Model.CurrentPage - 1)">Previous</button> }
        @for (int i = 1; i <= Model.TotalPages; i++) { <button class="pagination__link @(i == Model.CurrentPage ? "pagination__link--active" : "")" type="button" data-page="@i">@i</button> }
        @if (Model.CurrentPage < Model.TotalPages) { <button class="pagination__link" type="button" data-page="@(Model.CurrentPage + 1)">Next</button> }
    </div>
}