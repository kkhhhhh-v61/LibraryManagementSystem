@model ReservationVM

@{
    ViewBag.Title = "Create Reservation";
}

@section head {
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f6fa;
            color: #333;
        }

        /* ===== Center card in dashboard content ===== */
        .absolute-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100%;
            display: flex;
            justify-content: center;
        }

        /* Offset for sidebar width */
        @@media (min-width: 768px) {
            .absolute-center {
                padding-left: 240px; /* adjust if sidebar width differs */
            }
        }

        /* ===== Card ===== */
        .table-container {
            background-color: #fff;
            padding: 32px;
            border-radius: 14px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
            max-width: 520px;
            width: 100%;
            text-align: center; /* center title & buttons */
        }

        h1 {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 24px;
        }

        /* ===== Centered form block ===== */
        .form-wrapper {
            max-width: 320px;
            margin: 0 auto;
            text-align: left; /* keep labels readable */
        }

        .form-label {
            font-weight: 500;
            margin-bottom: 6px;
            color: #555;
        }

        .form-control {
            border-radius: 8px;
            padding: 10px 12px;
            font-size: 15px;
            border: 1px solid #dcdde1;
            margin-bottom: 18px;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.15rem rgba(52, 152, 219, 0.25);
            }

        /* ===== Buttons ===== */
        .button-group {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 10px;
        }

        .btn-primary {
            background-color: #3498db;
            border: none;
            padding: 8px 20px;
            font-weight: 500;
            border-radius: 6px;
            color: #fff !important;
        }

            .btn-primary:hover {
                background-color: #2980b9;
            }

        .btn-secondary {
            border-radius: 6px;
            padding: 8px 20px;
        }
    </style>
}

<div class="absolute-center">
    <div class="table-container">
        <h1>Create Reservation</h1>

        <!-- Business rule errors only -->
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="form-wrapper">
                <div>
                    <label asp-for="UserId" class="form-label">User ID</label>
                    <input asp-for="UserId"
                           class="form-control"
                           placeholder="e.g. C123" />
                </div>

                <div>
                    <label asp-for="BookId" class="form-label">Book ID</label>
                    <input asp-for="BookId"
                           class="form-control"
                           placeholder="e.g. B001" />
                </div>
            </div>

            <div class="button-group">
                <button type="submit" class="btn btn-primary">Reserve</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
