@{
    ViewBag.Title = "Home";
}

<div class="banner">
    <div id="banner-showcase">
        @for (int i = 1; i <= 5; i++)
        {
            <div class="banner__slide @(i == 1 ? "active" : "")">
                <img class="banner__image" src="/images/assets/placeholder-@(i % 2 == 0 ? 2 : 1).png" alt="Banner Image @i" />
                <div class="banner__content">
                    <h2 class="banner__title">Discover New Worlds @i</h2>
                    <p class="banner__description">Explore our vast collection of books and find your next adventure.</p>
                    <a href="#" class="banner__button">Browse Now</a>
                </div>
            </div>
        }
    </div>
    <button class="banner__arrow banner__arrow--prev" aria-label="Previous slide">&#10094;</button>
    <button class="banner__arrow banner__arrow--next" aria-label="Next slide">&#10095;</button>
    <div class="banner__nav"></div>
</div>

@* TODO: Make the sections load dynamically. *@

<section class="book-showcase">
    <div class="book-showcase__header">
        <h2 class="book-showcase__title">Featured</h2>
        <a href="#" class="book-showcase__view-all">View All</a>
    </div>
    <div class="book-showcase__content">
        @for (int i = 1; i <= 10; i++)
        {
            <a asp-controller="Catalogue" asp-action="Detail" class="book-card">
                <img class="book-card__image" src="/images/assets/placeholder-book.png" alt="Book Title" />
                <div class="book-card__overlay">
                    <h3 class="book-card__title">Featured Book @i</h3>
                    <p class="book-card__author">Author Name</p>
                    <div class="book-card__rating">
                        <span>★★★★☆</span>
                    </div>
                </div>
            </a>
        }
    </div>
</section>

