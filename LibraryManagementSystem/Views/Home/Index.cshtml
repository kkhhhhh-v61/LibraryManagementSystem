@{
    ViewBag.Title = "Home";
}

<div class="banner">
    <div id="banner-showcase">
        @* TODO: Dynamically load banner images *@
        <img class="banner__image" src="/images/assets/placeholder-1.png" alt="Banner Image 1" />
        <img class="banner__image" src="/images/assets/placeholder-2.png" alt="Banner Image 2" />
        <img class="banner__image" src="/images/assets/placeholder-1.png" alt="Banner Image 3" />
        <img class="banner__image" src="/images/assets/placeholder-2.png" alt="Banner Image 4" />
        <img class="banner__image" src="/images/assets/placeholder-1.png" alt="Banner Image 5" />
    </div>
    <div class="banner__nav"></div>
</div>

@* TODO: Make the sections load dynamically. *@

<section class="book-showcase">
    <nav class="book-showcase__nav">
        <button class="book-showcase__nav-button active" data-tab="featured">Featured</button>
        <button class="book-showcase__nav-button" data-tab="trending">Trending</button>
        <button class="book-showcase__nav-button" data-tab="new-arrivals">New Arrivals</button>
    </nav>

    <div id="featured" class="book-showcase__grid active">
        @for (int i = 1; i <= 10; i++)
        {
            <a href="#" class="book-card">
                <img class="book-card__image" src="/images/assets/placeholder-book.png" alt="Book Title" />
                <div class="book-card__overlay">
                    <h3 class="book-card__title">Featured Book @i</h3>
                    <p class="book-card__author">Author Name</p>
                    <div class="book-card__rating">
                        <span>★★★★☆</span>
                    </div>
                </div>
            </a>
        }
    </div>

    <div id="trending" class="book-showcase__grid">
        @for (int i = 1; i <= 10; i++)
        {
            <a href="#" class="book-card">
                <img class="book-card__image" src="/images/assets/placeholder-book.png" alt="Book Title" />
                <div class="book-card__overlay">
                    <h3 class="book-card__title">Trending Book @i</h3>
                    <p class="book-card__author">Author Name</p>
                    <div class="book-card__rating">
                        <span>★★★★☆</span>
                    </div>
                </div>
            </a>
        }
    </div>

    <div id="new-arrivals" class="book-showcase__grid">
        @for (int i = 1; i <= 10; i++)
        {
            <a href="#" class="book-card">
                <img class="book-card__image" src="/images/assets/placeholder-book.png" alt="Book Title" />
                <div class="book-card__overlay">
                    <h3 class="book-card__title">New Book @i</h3>
                    <p class="book-card__author">Author Name</p>
                    <div class="book-card__rating">
                        <span>★★★★☆</span>
                    </div>
                </div>
            </a>
        }
    </div>
</section>