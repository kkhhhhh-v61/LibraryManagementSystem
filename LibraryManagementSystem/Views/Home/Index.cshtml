@{
    ViewBag.Title = "Home";
}
<div id="banner-wrapper">
    <div id="banner-showcase">
        @* TODO: Dynamically load banner images *@
        <img src="/images/assets/placeholder-1.png" alt="Banner Image 1" />
        <img src="/images/assets/placeholder-2.png" alt="Banner Image 2" />
        <img src="/images/assets/placeholder-1.png" alt="Banner Image 3" />
        <img src="/images/assets/placeholder-2.png" alt="Banner Image 4" />
