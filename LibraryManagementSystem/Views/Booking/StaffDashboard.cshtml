@{
    ViewBag.Title = "Staff Dashboard";

    DateTime current = ViewBag.SelectedDate ?? DateTime.Today;

    string prevDate = current.AddDays(-1).ToString("yyyy-MM-dd");
    string nextDate = current.AddDays(1).ToString("yyyy-MM-dd");
    string dateString = current.ToString("yyyy-MM-dd");


    int startHour = 9;
    int endHour = 21;
    int totalHours = endHour - startHour;
}

@section head {
    <link rel="stylesheet" href="/css/booking.css" asp-append-version="true" />
}

<div class="page-container">

    <div class="dashboard-header">
        <div class="header-title">
            <h2>Master Schedule</h2>
            <p>Manage room availability and overrides</p>
        </div>

        <div class="control-group">
            <div class="legend">
                <div class="legend-item"><div class="dot" style="background:#10b981"></div>Member</div>
                <div class="legend-item"><div class="dot" style="background:#6366f1"></div>Staff</div>
                <div class="legend-item"><div class="dot" style="background:#d1d5db"></div>Maintenance</div>
            </div>

            <div class="date-nav">
                <a href="?date=@prevDate" class="btn-nav">◀</a>

                <form method="get" action="/Booking/StaffDashboard" style="margin:0; display:flex; align-items:center;">
                    <div class="date-display">
                        <input type="date" name="date" value="@dateString" class="date-picker-hidden" onchange="this.form.submit()" />
                    </div>
                </form>

                <a href="?date=@nextDate" class="btn-nav">▶</a>
            </div>

            <button class="btn-nav" style="background:var(--primary); color:white; border:none;">
                + New Booking
            </button>
        </div>
    </div>

    <div class="scheduler-wrapper">
        <div class="scheduler-scroll">

            <div class="timeline-header">
                <div class="header-corner"></div> @for (int i = startHour; i <= endHour; i++)
                {
                    <div class="time-slot">@i:00</div>
                }
            </div>

            <div class="timeline-row">
                <div class="room-col">
                    <span class="room-name">Discussion Room A</span>
                    <span class="room-cap">Cap: 4 Pax</span>
                </div>
                <div class="track-col" style="width: @(totalHours * 100 + 100)px;">

                    <div class="booking-chip status-member"
                         style="left: @((10 - startHour) * 100)px; width: @(2 * 100)px;">
                        <span class="chip-user">Ali (Student)</span>
                        <span class="chip-time">10:00 - 12:00</span>
                    </div>

                </div>
            </div>

            <div class="timeline-row">
                <div class="room-col">
                    <span class="room-name">Music Room</span>
                    <span class="room-cap">Cap: 2 Pax</span>
                </div>
                <div class="track-col" style="width: @(totalHours * 100 + 100)px;">

                    <div class="booking-chip status-staff"
                         style="left: @((13 - startHour) * 100)px; width: @(2.5 * 100)px;">
                        <span class="chip-user">Staff Override</span>
                        <span class="chip-time">13:00 - 15:30</span>
                    </div>

                </div>
            </div>

            <div class="timeline-row">
                <div class="room-col">
                    <span class="room-name">Conference Hall</span>
                    <span class="room-cap">Cap: 50 Pax</span>
                </div>
                <div class="track-col" style="width: @(totalHours * 100 + 100)px;">

                    <div class="booking-chip status-maint"
                         style="left: @((9 - startHour) * 100)px; width: @(4 * 100)px;">
                        <span class="chip-user" style="color:#6b7280;">⚠️ Cleaning</span>
                        <span class="chip-time">09:00 - 13:00</span>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>