@model List<LibraryManagementSystem.Models.Booking>
@{
    ViewBag.Title = "Bookings History";
}

@section head {
    <style>
        body {
            background: #f8fafc;
            font-family: 'Inter', sans-serif;
        }

        .container-bookings {
            max-width: 900px;
            margin: 40px auto;
            padding: 20px;
        }

        .page-header {
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .page-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: #1e293b;
            margin: 0;
        }

        .booking-item {
            background: white;
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 20px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: transform 0.2s;
        }

            .booking-item:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px -3px rgba(0,0,0,0.05);
            }

        .info-main h4 {
            margin: 0 0 8px 0;
            font-size: 1.2rem;
            color: #1e293b;
        }

        .info-sub {
            color: #64748b;
            font-size: 0.9rem;
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .badge {
            padding: 6px 12px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .bg-pending {
            background: #fff7ed;
            color: #c2410c;
            border: 1px solid #ffedd5;
        }

        .bg-confirmed {
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #d1fae5;
        }

        .bg-cancelled {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fee2e2;
        }

        .bg-completed {
            background: #f1f5f9;
            color: #475569;
            border: 1px solid #e2e8f0;
        }

        .btn-cancel {
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            background: white;
            border: 1px solid #e2e8f0;
            color: #ef4444;
            cursor: pointer;
            transition: all 0.2s;
        }

            .btn-cancel:hover {
                background: #fef2f2;
                border-color: #fee2e2;
            }
    </style>
}

<div class="container-bookings">
    <div class="page-header">
        <h2 class="page-title">My Bookings</h2>
        <a href="/Booking/Index" style="text-decoration:none; color:#4f46e5; font-weight:600;">+ New Booking</a>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center; padding:60px; color:#94a3b8; background:white; border-radius:12px; border:1px solid #e2e8f0;">
            <p>You haven't made any bookings yet.</p>
        </div>
    }

    @foreach (var item in Model)
    {
        <div class="booking-item">
            <div class="info-main">
                <h4>@item.Room.Name <span style="font-weight:400; color:#94a3b8; font-size:0.9rem;">(@item.Room.RoomCategory.Name)</span></h4>
                <div class="info-sub">
                    <span>📅 @item.StartTime.ToString("dd MMM yyyy")</span>
                    <span>⏰ @item.StartTime.ToString("hh:mm tt") - @item.EndTime.ToString("hh:mm tt")</span>
                    <span style="font-weight:700; color:#4f46e5;">RM @item.TotalPrice.ToString("F2")</span>
                </div>
            </div>

            <div style="text-align:right; display:flex; flex-direction:column; align-items:flex-end; gap:10px;">
                @if (item.Status == LibraryManagementSystem.Models.Booking.BookingStatus.PENDING)
                {
                    <span class="badge bg-pending">Pending Payment</span>
                }
                else if (item.Status == LibraryManagementSystem.Models.Booking.BookingStatus.CONFIRMED)
                {
                    <span class="badge bg-confirmed">Confirmed</span>
                }
                else if (item.Status == LibraryManagementSystem.Models.Booking.BookingStatus.CANCELLED)
                {
                    <span class="badge bg-cancelled">Cancelled</span>
                }
                else
                {
                    <span class="badge bg-completed">Completed</span>
                }

                @if (item.Status == LibraryManagementSystem.Models.Booking.BookingStatus.PENDING ||
                            item.Status == LibraryManagementSystem.Models.Booking.BookingStatus.CONFIRMED)
                {
                    <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this booking?');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn-cancel">Cancel</button>
                    </form>
                }
            </div>
        </div>
    }
</div>