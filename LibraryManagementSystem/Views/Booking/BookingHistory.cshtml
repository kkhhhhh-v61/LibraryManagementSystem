@model List<LibraryManagementSystem.Models.Booking>
@{
    ViewBag.Title = "Bookings History";
}

@section head {
    <link rel="stylesheet" href="~/css/history.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
}

<div style="background-color: #f8fafc; min-height: 100vh; padding: 1px 0;">

    <div class="container-bookings">
        <div class="page-header">
            <h2 class="page-title">My Bookings</h2>

            <div class="search-bar-group">
                <input type="text" id="searchInput" class="search-input" placeholder="Search by Room, Category, Price..."
                       oninput="debouncedSearch()" />

                <input type="date" id="dateInput" class="search-input" style="width: auto;"
                       onchange="debouncedSearch()" />
            </div>

            <a href="/Booking/Index" class="btn-new-booking">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                New
            </a>
        </div>

        <div id="bookingListContainer">
            <partial name="_BookingList" model="Model" />
        </div>
    </div>

</div>

<div id="cancelModal" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
        </div>

        <h3 class="modal-title" id="modalTitle">Cancel Booking?</h3>
        <p class="modal-desc" id="modalDesc">Are you sure you want to cancel this booking?</p>

        <div id="modalDetails" style="background: #f8fafc; padding: 15px; border-radius: 8px; margin-bottom: 20px; text-align: left; font-size: 0.9rem; border: 1px solid #e2e8f0;">
            <div style="margin-bottom: 5px;"><strong>Room:</strong> <span id="displayRoom" style="color:#4f46e5;"></span></div>
            <div style="margin-bottom: 5px;"><strong>Category:</strong> <span id="displayCat"></span></div>
            <div><strong>Date & Time:</strong> <br><span id="displayTime" style="color:#64748b; font-size:0.85rem;"></span></div>
        </div>

        <form asp-action="Cancel" method="post" id="modalForm">
            <input type="hidden" name="id" id="modalBookingId" />

            <div id="reasonSection" style="text-align: left; margin-bottom: 20px; display: none;">
                <label for="reason" style="font-size: 0.85rem; font-weight: 600; margin-bottom: 5px; display: block;">
                    Reason <span style="color:red">*</span>
                </label>

                <textarea name="reason" id="modalReason" rows="3"
                          style="width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #cbd5e1; font-family: inherit; font-size: 0.9rem;"
                          minlength="5"
                          maxlength="250"></textarea>

                <div style="font-size: 0.75rem; color: #64748b; margin-top: 4px; display: flex; justify-content: space-between;">
                    <span>At least 5 characters.</span>
                    <span id="charCount">0/250</span>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-modal-cancel" onclick="closeModal()">No, Keep it</button>
                <button type="submit" class="btn-modal-confirm" id="modalConfirmBtn">Yes, Cancel</button>
            </div>
        </form>
    </div>
</div>

@section foot {
    <script src="~/js/booking.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            @if (TempData["Success"] != null)
            {
                    <text>if(window.showToast) showToast('@TempData["Success"]', 'success');</text>
            }
            @if (TempData["Error"] != null)
            {
                    <text>if(window.showToast) showToast('@TempData["Error"]', 'error');</text>
            }
        });
    </script>
}