@model BookingCreateVM
@{
    ViewBag.Title = "New Booking";

    var allCategories = ViewBag.Categories as List<RoomCategory>;
    var activeCat = allCategories?.FirstOrDefault(c => c.Id == Model.RoomCategoryId);

    string imgName = activeCat?.ImageURL;
    string imgSrc = string.IsNullOrEmpty(imgName)
        ? "https://placehold.co/1200x900/e2e8f0/64748b?text=Select+Category"
        : $"/images/categories/{imgName}?v={DateTime.Now.Ticks}";
}

@section head {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/css/booking.css" rel="stylesheet" asp-append-version="true" />
}


<div class="dashboard-container">

    <div class="booking-card">

        <div class="layout-left-img">
            <img src="@imgSrc" class="img-cover"
                 onerror="this.onerror=null; this.src='https://placehold.co/1200x900/e2e8f0/64748b?text=Image+Error';" />

            <div class="img-overlay">
                <div class="overlay-title">@(activeCat?.Name ?? "Book a Room")</div>
                <div class="overlay-desc">
                    @(string.IsNullOrEmpty(activeCat?.Description) ? "Select a category to view pricing and details." : activeCat.Description)
                </div>
            </div>
        </div>

        <div class="layout-right-form">

            <div class="form-content-wrapper">

                <div class="form-header">
                    <h2>New Booking</h2>
                    <p>Please fill in the details below to book your slot.</p>
                </div>

                <form asp-action="Create" method="post">
                    <input type="hidden" id="hourlyRate" value="@(activeCat?.HourlyRate ?? 0)" />

                    <div class="form-group">
                        <label class="form-label">Room Category</label>
                        <select asp-for="RoomCategoryId" asp-items="Model.CategoryList" class="form-input"
                                onchange="window.location.href='?date=@Model.BookingDate.ToString("yyyy-MM-dd")&roomCategoryId=' + this.value">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="RoomCategoryId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Date</label>
                        <input asp-for="BookingDate" class="form-input"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="BookingDate" class="text-danger"></span>
                    </div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label class="form-label">Start Time</label>
                            <input asp-for="StartTime" type="time" id="inputStart" class="form-input" onchange="calculateTotal()" />
                            <span asp-validation-for="StartTime" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">End Time</label>
                            <input asp-for="EndTime" type="time" id="inputEnd" class="form-input" onchange="calculateTotal()" />
                            <span asp-validation-for="EndTime" class="text-danger"></span>
                        </div>
                    </div>

                    <div style="font-size:0.85rem; color:var(--warning); font-weight:600; margin-bottom:20px; display:flex; align-items:center; gap:5px;">
                        <span>
                            <svg xmlns="http://www.w3.org/2000/svg" height="25px" viewBox="0 -960 960 960" width="40px" fill="#0000F5"><path d="m622-288.67 48.67-48.66-155.34-156v-195.34h-66.66v222l173.33 178ZM480-80q-82.33 0-155.33-31.5-73-31.5-127.34-85.83Q143-251.67 111.5-324.67T80-480q0-82.33 31.5-155.33 31.5-73 85.83-127.34Q251.67-817 324.67-848.5T480-880q82.33 0 155.33 31.5 73 31.5 127.34 85.83Q817-708.33 848.5-635.33T880-480q0 82.33-31.5 155.33-31.5 73-85.83 127.34Q708.33-143 635.33-111.5T480-80Zm0-400Zm0 333.33q137.67 0 235.5-97.83 97.83-97.83 97.83-235.5 0-137.67-97.83-235.5-97.83-97.83-235.5-97.83-137.67 0-235.5 97.83-97.83 97.83-97.83 235.5 0 137.67 97.83 235.5 97.83 97.83 235.5 97.83Z" /></svg>
                        </span> Operating Hours: 09:00 - 21:00
                    </div>

                    <div class="cost-box">
                        <div class="cost-row">
                            <span>Hourly Rate</span>
                            <span>RM @(activeCat?.HourlyRate.ToString("F2") ?? "0.00") / hr</span>
                        </div>
                        <div class="cost-row">
                            <span>Duration</span>
                            <span><span id="displayDuration">0.0</span> hrs</span>
                        </div>
                        <div class="cost-total">
                            <span>Total Estimate</span>
                            <span>RM <span id="displayPrice">0.00</span></span>
                        </div>
                    </div>

                    <button type="submit" class="btn-save">Confirm Booking</button>
                </form>

            </div>
        </div>
    </div>
</div>

@section foot {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/booking.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            @if (TempData["Success"] != null)
            {
                    <text>if(window.showToast) showToast('@TempData["Success"]', 'success');</text>
            }

            @if (TempData["Error"] != null)
            {
                    <text>if(window.showToast) showToast('@TempData["Error"]', 'error');</text>
            }

            @if (!ViewData.ModelState.IsValid && TempData["Error"] == null)
            {
                    <text>if(window.showToast) showToast('Please check input fields.', 'error');</text>
            }
        });
    </script>
}