@model BookingIndexVM
@{
    ViewBag.Title = "Book a Room";

    var activeCategory = Model.Categories.FirstOrDefault(c => c.Id == Model.CurrentCategoryId);
    var dateString = Model.BookingDate.ToString("yyyy-MM-dd");

    string imgName = activeCategory?.ImageURL;
    string imgSrc;

    if (string.IsNullOrEmpty(imgName))
    {
        imgSrc = "https://placehold.co/1200x800/e2e8f0/64748b?text=No+Image+Uploaded";
    }
    else
    {
        imgSrc = $"/images/categories/{imgName}?v={DateTime.Now.Ticks}";
    }
}

@section head {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/css/booking.css" rel="stylesheet" asp-append-version="true" />
}

<div class="booking-page-wrapper">

    <div class="category-header">
        <div class="category-label">Choose Room Type</div>
        <div class="category-scroll-container">
            <div class="category-track" id="categoryTrack">
                @foreach (var cat in Model.Categories)
                {
                    bool isActive = cat.Id == Model.CurrentCategoryId;

                    <a href="?categoryId=@cat.Id&date=@dateString"
                       class="cat-card @(isActive ? "active" : "")"
                       id="cat-@cat.Id">
                        <span class="cat-name">@cat.Name</span>
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="main-content">

        <div class="visual-section">

            <div class="price-floater">
                <span class="curr">RM</span>
                <span class="val">@(activeCategory?.HourlyRate.ToString("F2") ?? "0.00")</span>
                <span class="unit">/ hr</span>
            </div>

            <img src="@imgSrc"
                 alt="@activeCategory?.Name"
                 class="room-bg"
                 onerror="this.onerror=null; this.src='https://placehold.co/1200x800/f1f5f9/94a3b8?text=Image+Not+Found';" />

            <div class="info-overlay">
                <h1 class="info-title">@activeCategory?.Name</h1>
                <p class="info-desc">
                    @(string.IsNullOrEmpty(activeCategory?.Description)
                                        ? "A perfect space for your needs. Book now to secure your slot."
                                        : activeCategory.Description)
                </p>
            </div>
        </div>

        <div class="form-section">
            <div class="form-head">
                <h3>Make a Room Reservation</h3>
                <p>Select your date and time (09:00 - 21:00)</p>
            </div>

            <form asp-action="Create" method="post" class="booking-form">

                <input type="hidden" asp-for="RoomCategoryId" value="@Model.CurrentCategoryId" />
                <input type="hidden" id="hourlyRate" value="@(activeCategory?.HourlyRate ?? 0)" />

                <div class="field-group">
                    <label>Date</label>
                    <input asp-for="BookingDate" type="date" id="inputDate" class="field-input"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="BookingDate" class="val-error"></span>
                </div>

                <div class="row-split">
                    <div class="field-group">
                        <label>Start Time</label>
                        <input asp-for="StartTime" type="time" id="inputStart" class="field-input"
                               min="09:00" max="21:00" onchange="calculateTotal()" />
                        <span asp-validation-for="StartTime" class="val-error"></span>
                    </div>
                    <div class="field-group">
                        <label>End Time</label>
                        <input asp-for="EndTime" type="time" id="inputEnd" class="field-input"
                               min="09:00" max="21:00" onchange="calculateTotal()" />
                        <span asp-validation-for="EndTime" class="val-error"></span>
                    </div>
                </div>
                <div class="op-hours">⚠️ Operating Hours: 9 AM - 9 PM</div>

                <div class="estimate-box">
                    <div class="est-row">
                        <span>Duration</span>
                        <span><span id="displayDuration">0</span> hrs</span>
                    </div>
                    <div class="est-row final">
                        <span class="est-label">Total Estimate</span>
                        <span class="est-amount">RM <span id="displayPrice">0.00</span></span>
                    </div>
                </div>

                <button type="submit" class="btn-book">
                    Confirm Booking
                </button>

            </form>
        </div>
    </div>
</div>

@section foot {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function calculateTotal() {
            const startVal = document.getElementById('inputStart').value;
            const endVal = document.getElementById('inputEnd').value;
            const rate = parseFloat(document.getElementById('hourlyRate').value) || 0;

            if (startVal && endVal) {
                const base = "2000-01-01T";
                const s = new Date(base + startVal);
                const e = new Date(base + endVal);

                let diffMs = e - s;
                let hours = diffMs / 1000 / 60 / 60;

                if (hours < 0) hours = 0;

                document.getElementById('displayDuration').innerText = hours.toFixed(1);

                const total = hours * rate;
                document.getElementById('displayPrice').innerText = total.toFixed(2);
            } else {
                document.getElementById('displayDuration').innerText = "0";
                document.getElementById('displayPrice').innerText = "0.00";
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            calculateTotal();
            const activeCard = document.querySelector('.cat-card.active');
            if (activeCard) {
                activeCard.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
        });
    </script>
}