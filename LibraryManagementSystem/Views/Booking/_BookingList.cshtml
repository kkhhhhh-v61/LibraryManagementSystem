@model List<LibraryManagementSystem.Models.Booking>

@if (!Model.Any())
{
    <div class="empty-state" style="grid-column: 1 / -1;">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:15px; opacity:0.5;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <p>No bookings found matching your search.</p>
    </div>
}

@{
    int rowNo = Model.Count;
}

@foreach (var item in Model)
{
    <div class="booking-item">

        <div class="date-box">
            <span class="date-month">@item.StartTime.ToString("MMM")</span>
            <span class="date-day">@item.StartTime.ToString("dd")</span>
            <span class="date-year">@item.StartTime.ToString("yyyy")</span>
        </div>

        <div class="info-section">
            <span class="seq-number">
                <span style="margin-left:2px; opacity:0.5;">NO. @(rowNo--)</span>
            </span>

            <div class="room-title">
                @item.Room.Name
                <span class="category-tag">@item.Room.RoomCategory.Name</span>
            </div>
            <div class="info-details">
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px; vertical-align:text-bottom;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    @item.StartTime.ToString("hh:mm tt") - @item.EndTime.ToString("hh:mm tt")
                </span>
                <span class="price-tag">RM @item.TotalPrice.ToString("F2")</span>
            </div>
        </div>

        <div class="action-section">
            @{
                var now = DateTime.Now;
                bool isStarted = now >= item.StartTime;
                bool isEnded = now >= item.EndTime;
                bool isInProgress = isStarted && !isEnded;
            }

            @if (item.Status == LibraryManagementSystem.Models.Booking.BookingStatus.PENDING)
            {
                <span class="badge bg-pending">Pending</span>
            }
            else if (item.Status == LibraryManagementSystem.Models.Booking.BookingStatus.CONFIRMED)
            {
                if (isEnded)
                {
                    <span class="badge bg-completed">Completed</span>
                }
                else if (isInProgress)
                {
                    <span class="badge bg-inprogress">In Progress</span>
                }
                else
                {
                    <span class="badge bg-confirmed">Confirmed</span>
                }
            }
            else if (item.Status == LibraryManagementSystem.Models.Booking.BookingStatus.CANCELLED)
            {
                <span class="badge bg-cancelled">Cancelled</span>
            }
            else
            {
                <span class="badge bg-completed">Completed</span>
            }

            @if (!isStarted)
            {
                if (item.Status == LibraryManagementSystem.Models.Booking.BookingStatus.PENDING)
                {
                    <form asp-action="Cancel" method="post" onsubmit="return confirm('Are you sure you want to cancel this booking?');" style="margin:0;">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn-cancel">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            Cancel
                        </button>
                    </form>
                }
                else if (item.Status == LibraryManagementSystem.Models.Booking.BookingStatus.CONFIRMED)
                {
                    <form asp-action="Cancel" method="post" onsubmit="return confirm('This booking is paid. Are you sure you want to cancel and request a refund?');" style="margin:0;">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn-cancel" style="color:#d97706; border-color:#d97706;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6" /><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13" /></svg>
                            Refund
                        </button>
                    </form>
                }
            }
        </div>
    </div>
}