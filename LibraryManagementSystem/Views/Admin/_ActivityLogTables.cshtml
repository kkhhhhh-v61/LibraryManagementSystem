@model LibraryManagementSystem.Models.ActivityLogVM

@{
    string GetSortIcon(string paramName)
    {
        var currentSort = ViewData["CurrentSort"] as string;
        if (string.IsNullOrEmpty(currentSort)) currentSort = "id_desc";

        if (currentSort == paramName) return "<i class='fas fa-sort-up'></i>";
        if (currentSort == paramName + "_desc") return "<i class='fas fa-sort-down'></i>";
        return "<i class='fas fa-sort' style='opacity:0.3'></i>";
    }
}
@if (Model.TotalPages > 0)
{
    <div class="pagination-wrapper">
        <button class="page-btn"
                onclick="changePage(@(Model.CurrentPage - 1))"
                @(Model.HasPrevious ? "" : "disabled")>
            <i class="fas fa-arrow-left"></i> Previous
        </button>

        <span class="page-info">
            Page @Model.CurrentPage of @Model.TotalPages
        </span>

        <button class="page-btn"
                onclick="changePage(@(Model.CurrentPage + 1))"
                @(Model.HasNext ? "" : "disabled")>
            Next <i class="fas fa-arrow-right"></i>
        </button>
    </div>
}

<style>
    .pagination-wrapper {
        display: flex;
        justify-content: flex-end; /* Aligns to the right like your screenshot */
        align-items: center;
        gap: 15px;
        margin-top: 20px;
        padding-top: 15px;
        border-top: 1px solid #f1f5f9;
    }

    .page-btn {
        background-color: transparent;
        border: 1px solid var(--primary-color);
        color: var(--primary-color);
        padding: 6px 16px;
        border-radius: 20px; /* Pill shape */
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .page-btn:hover:not(:disabled) {
            background-color: var(--primary-color);
            color: white;
        }

        .page-btn:disabled {
            border-color: #cbd5e1;
            color: #cbd5e1;
            cursor: not-allowed;
        }

    .page-info {
        color: var(--text-muted);
        font-weight: 500;
        font-size: 0.95rem;
    }
    /* 1. Make the header clickable */
    .sortable-th {
        cursor: pointer;
        transition: background 0.2s;
        user-select: none;
        vertical-align: middle !important; /* Ensure vertical center */
    }

        .sortable-th:hover {
            background-color: #f1f5f9;
            color: var(--primary-color);
        }

    /* 2. NEW: Flexbox container to keep text and arrow side-by-side */
    .th-flex {
        display: flex;
        align-items: center; /* Aligns text and arrow vertically */
        gap: 8px; /* Adds space between text and arrow */
        white-space: nowrap; /* Prevents wrapping to next line */
    }
</style>

<div id="loansTableSection">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th class="sortable-th" style="width: 10%;" onclick="ajaxSort('@ViewData["IdSortParam"]')">
                        <div class="th-flex">
                            Loan ID @Html.Raw(GetSortIcon(""))
                        </div>
                    </th>

                    <th style="width: 30%;">Book Details</th>

                    <th class="sortable-th" style="width: 25%;" onclick="ajaxSort('@ViewData["UserSortParam"]')">
                        <div class="th-flex">
                            User Profile @Html.Raw(GetSortIcon("user"))
                        </div>
                    </th>

                    <th class="sortable-th" style="width: 20%;" onclick="ajaxSort('@ViewData["DateSortParam"]')">
                        <div class="th-flex">
                            Timeline @Html.Raw(GetSortIcon("date"))
                        </div>
                    </th>

                    <th class="sortable-th" style="width: 15%;" onclick="ajaxSort('@ViewData["StatusSortParam"]')">
                        <div class="th-flex" style="justify-content: flex-end;">
                            Status @Html.Raw(GetSortIcon("status"))
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Loans != null && Model.Loans.Any())
                {
                    @foreach (var loan in Model.Loans)
                    {
                        <tr>
                            <td style="color: var(--primary-color); font-weight: 700;">#@loan.LoanId</td>
                            <td>
                                <div class="book-flex">
                                    <img src="/images/books/@(string.IsNullOrEmpty(loan.BookImageUrl) ? "default-book.png" : loan.BookImageUrl)"
                                         onerror="this.onerror=null; this.src='/images/books/default-book.png'"
                                         class="table-book-img" alt="Cover" />
                                    <div>
                                        <span class="text-main">@loan.BookTitle</span>
                                        <span class="text-sub">ID: @loan.LoanId</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="user-profile-flex">
                                    <img src="/images/profiles/@(string.IsNullOrEmpty(loan.UserProfileUrl) ? "default-user.png" : loan.UserProfileUrl)"
                                         onerror="this.onerror=null; this.src='/images/assets/default-user.png'"
                                         class="table-avatar" alt="User" />
                                    <div>
                                        <span class="text-main">@loan.UserName</span>
                                        <span class="text-sub">@loan.UserEmail</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="margin-bottom: 4px;">
                                    <span class="text-sub">Out: </span>
                                    <span style="font-weight: 500; color: #475569;">@loan.LoanDate.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div>
                                    <span class="text-sub">Due: </span>
                                    <span style="font-weight: 600; color: var(--danger-color);">@loan.LoanDue.ToString("MMM dd, yyyy")</span>
                                </div>
                            </td>
                            <td style="text-align: right;">
                                @if (loan.Status == "Returned")
                                {
                                    <span class="status-pill returned">Returned</span>
                                }
                                else if (loan.Status == "Reserved")
                                {

                                    <span class="status-pill reserved">Reserved</span>
                                }
                                else
                                {

                                    <span class="status-pill active">@loan.Status</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align:center; padding: 60px; color: var(--text-muted);">
                            <i class="bi bi-inbox" style="font-size: 2rem; display: block; margin-bottom: 10px;"></i>
                            No loan history found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div id="bookingsTableSection" style="display: none;">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th class="sortable-th" style="width: 10%;" onclick="ajaxSort('@ViewData["IdSortParam"]')">
                        <div class="th-flex">
                            ID @Html.Raw(GetSortIcon(""))
                        </div>
                    </th>
                    <th style="width: 30%;">Facility</th>
                    <th class="sortable-th" style="width: 25%;" onclick="ajaxSort('@ViewData["UserSortParam"]')">
                        <div class="th-flex">
                            User @Html.Raw(GetSortIcon("user"))
                        </div>
                    </th>
                    <th class="sortable-th" style="width: 20%;" onclick="ajaxSort('@ViewData["DateSortParam"]')">
                        <div class="th-flex">
                            Timeline @Html.Raw(GetSortIcon("date"))
                        </div>
                    </th>
                    <th class="sortable-th" style="width: 15%;" onclick="ajaxSort('@ViewData["StatusSortParam"]')">
                        <div class="th-flex" style="justify-content: flex-end;">
                            Status @Html.Raw(GetSortIcon("status"))
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Bookings != null && Model.Bookings.Any())
                {
                    @foreach (var booking in Model.Bookings)
                    {
                        <tr>
                            <td style="color: var(--primary-color); font-weight: 700;">#@booking.BookingId</td>
                            <td>
                                <span class="text-main">@booking.FacilityName</span>
                                <span class="text-sub">Facility Booking</span>
                            </td>
                            <td>
                                <div class="user-profile-flex">
                                    <img src="/images/profiles/@(string.IsNullOrEmpty(booking.UserProfileUrl) ? "default-profile.png" : booking.UserProfileUrl)"
                                         onerror="this.onerror=null; this.src='/images/assets/default-profile.png'"
                                         class="table-avatar" alt="User" />
                                    <div>
                                        <span class="text-main">@booking.UserName</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="text-main">@booking.BookingDate.ToString("MMM dd, yyyy")</span>
                                <span class="text-sub">@booking.StartTime - @booking.EndTime</span>
                            </td>
                            <td style="text-align: right;">
                                <span class="status-pill reserved">@booking.Status</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align:center; padding: 60px; color: var(--text-muted);">
                            <i class="bi bi-calendar-x" style="font-size: 2rem; display: block; margin-bottom: 10px;"></i>
                            No booking history found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>