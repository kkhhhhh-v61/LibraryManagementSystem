@model LibraryManagementSystem.Models.PaymentVM
@{
    ViewBag.Title = "Secure Checkout";

    var b = Model.Booking;
    var duration = (b.EndTime - b.StartTime).TotalHours;
    var finalTotal = b.TotalPrice;

    var imgName = b.Room.RoomCategory.ImageURL;
    var imgSrc = string.IsNullOrEmpty(imgName)
        ? ""
        : $"/images/categories/{imgName}";
}

@section head {
    <link rel="stylesheet" href="~/css/payment.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        .text-danger {
            color: #ef4444;
            font-size: 0.8rem;
            margin-top: 4px;
            display: block;
        }

        .input-error {
            border-color: #ef4444 !important;
        }
    </style>
}

<div class="checkout-container">

    <div class="page-header">
        <h1 class="page-title">Checkout</h1>
        <div class="page-subtitle">Complete your booking securely</div>
    </div>

    <div class="card-box">
        <div class="card-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            Payment Details
        </div>

        <div class="payment-options">
            <div class="option-item active" onclick="selectTab(this)">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                <span class="option-text">Card</span>
            </div>
        </div>

        <form asp-controller="Payment" asp-action="Process" method="post" id="payForm">

            <input type="hidden" asp-for="BookingId" />

            <div class="form-group">
                <label class="form-label" asp-for="CardName"></label>
                <div class="input-wrapper">
                    <input asp-for="CardName" class="form-input" placeholder="Name on card" />
                    <svg class="input-icon-right" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </div>
                <span asp-validation-for="CardName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="CardNumber"></label>
                <div class="input-wrapper">
                    <input asp-for="CardNumber" id="cardNumber"  class="form-input" placeholder="1234 5678 9012 3456" maxlength="19" />
                    <svg class="input-icon-right" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                </div>
                <span asp-validation-for="CardNumber" class="text-danger"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Expiration (MM/YY)</label>
                    <input asp-for="ExpiryDate" id="expiryDate" class="form-input" placeholder="MM/YY" maxlength="5" />
                    <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Cvc"></label>
                    <div class="input-wrapper">
                        <input asp-for="Cvc" type="password" class="form-input" placeholder="123" maxlength="3" />
                        <svg class="input-icon-right" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </div>
                    <span asp-validation-for="Cvc" class="text-danger"></span>
                </div>
            </div>

            <div style="font-size:0.8rem; color:#64748b; display:flex; gap:6px; align-items:center; margin-top:10px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <span>Encrypted and secured connection.</span>
            </div>
        </form>
    </div>

    <div class="summary-container">
        <div class="card-box">
            <div class="card-title">Order Summary</div>

            <div class="room-preview">
                <div class="img-placeholder">
                    @if (!string.IsNullOrEmpty(imgSrc))
                    {
                        <img src="@imgSrc" class="room-img" onerror="this.style.display='none'; this.parentElement.classList.add('error');" />
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    }
                </div>
                <div class="room-details">
                    <h4>@b.Room.Name</h4>
                    <span class="badge-cat">@b.Room.RoomCategory.Name</span>
                </div>
            </div>

            <div class="info-list">
                <div class="info-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    <span>@b.StartTime.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="info-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <span>@b.StartTime.ToString("hh:mm tt") - @b.EndTime.ToString("hh:mm tt")</span>
                </div>
                <div class="info-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <span>@duration.ToString("0.#") Hours</span>
                </div>
            </div>

            <div class="total-section">
                <span class="total-label">Total</span>
                <span class="total-value">RM @finalTotal.ToString("F2")</span>
            </div>

            <button type="button" class="btn-submit" onclick="document.getElementById('payForm').submit();">
                Confirm & Pay
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>

            <form asp-controller="Payment" asp-action="Cancel" method="post" style="margin:0;">
                <button type="submit" class="btn-cancel-link">
                    Cancel & Return
                </button>
            </form>
        </div>
    </div>
</div>

@section foot {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            @if (TempData["Success"] != null)
            {
                        <text>showToast('@TempData["Success"]', 'success');</text>
            }
            @if (TempData["Error"] != null)
            {
                        <text>showToast('@TempData["Error"]', 'error');</text>
            }
        });

        function selectTab(el) {
            document.querySelectorAll('.option-item').forEach(i => i.classList.remove('active'));
            el.classList.add('active');
        }

        document.getElementById('cardNumber').addEventListener('input', function (e) {
            let value = e.target.value.replace(/\D/g, '');

            let formattedValue = '';
            for (let i = 0; i < value.length; i++) {
                if (i > 0 && i % 4 === 0) {
                    formattedValue += ' ';
                }
                formattedValue += value[i];
            }

            e.target.value = formattedValue;
        });

        document.getElementById('expiryDate').addEventListener('input', function (e) {
            let value = e.target.value.replace(/\D/g, '');

            if (value.length > 4) value = value.substring(0, 4);

            if (value.length > 2) {
                e.target.value = value.substring(0, 2) + '/' + value.substring(2);
            } else {
                e.target.value = value;
            }
        });
    </script>
}