@model IEnumerable<LibraryManagementSystem.Models.User>

<div class="container mt-4">
    <h2>User Management</h2>

    <form asp-action="UserList" method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="searchString" class="form-control" placeholder="Search by name, email or ID..." />
            <button class="btn btn-primary" type="submit">Search</button>
        </div>
    </form>

    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>
                        <img src="@(item.ImageURL ?? "/images/default-user.png")" width="30" height="30" class="rounded-circle me-2">
                        @item.Username
                    </td>
                    <td>@item.Email</td>
                    <td><span class="badge bg-secondary">@item.Role</span></td>
                    <td>
                        @if (item.Status == LibraryManagementSystem.Models.User.UserStatus.ACTIVE)
                        {
                            <span class="text-success">Active</span>
                        }
                        else
                        {
                            <span class="text-danger">@item.Status</span>
                        }
                    </td>
                    <td>
                        <a asp-action="UserDetails" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">View Profile</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>