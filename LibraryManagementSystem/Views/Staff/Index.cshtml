@model IEnumerable<LibraryManagementSystem.Models.User>

@{
    ViewData["Title"] = "User Management";
    int userCount = Model.Count();
}

<link rel="stylesheet" href="~/css/UserList.css" />

<div class="container-fluid">
    <div class="bookbase-card">

        <div class="card-header-custom">
            <div class="header-left">
                <h2 class="page-title">User Management</h2>
                <span id="totalRecordsBadge" class="record-badge">@userCount Records</span>

                @if (User.IsInRole("ADMIN"))
                {
                    <a href="/Admin/CreateStaff" class="btn-new-staff">
                        <i class="fas fa-plus-circle me-1"></i> New Staff
                    </a>
                }
            </div>

            <div class="search-box">
                <i class="fas fa-search search-icon"></i>
                <input type="text"
                       id="userSearchInput"
                       class="search-input"
                       placeholder="Search users..."
                       value="@ViewData["CurrentFilter"]"
                       autocomplete="off"
                       oninput="handleSearch(this.value)" />
                <i class="fas fa-times"
                   id="clearSearchBtn"
                   onclick="clearSearch()"
                   style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #888; display: none;">
                </i>
            </div>
        </div>

        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th style="width: 10%; cursor: pointer;" onclick="handleSort('id')">
                            USER ID <i id="icon_id" class="fas fa-sort"></i>
                        </th>

                        <th style="width: 30%; cursor: pointer;" onclick="handleSort('name')">
                            USER <i id="icon_name" class="fas fa-sort"></i>
                        </th>

                        <th style="width: 10%; cursor: pointer;" onclick="handleSort('role')">
                            ROLE <i id="icon_role" class="fas fa-sort"></i>
                        </th>

                        <th style="width: 10%;">STATUS</th>
                        <th style="width: 15%;">PHONE</th>
                        <th class="text-end" style="width: 5%;">ACTION</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    <partial name="_UserTableBody" model="Model" />
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-column align-items-center mt-2">
            <div class="pagination-wrapper mb-2">
                <button type="button" id="btnPrev" class="btn-nav p-prev" onclick="changePage(-1)"
                        @(ViewBag.HasPrevious ? "" : "disabled")>
                    <i class="fas fa-arrow-left me-2"></i> Previous
                </button>

                <span class="page-indicator mx-4">
                    <span id="pageInfo">
                        Page <span class="fw-bold text-dark">@ViewBag.CurrentPage</span>
                        of <span class="fw-bold text-dark">@(ViewBag.TotalPages == 0 ? 1 : ViewBag.TotalPages)</span>
                    </span>
                </span>

                <button type="button" id="btnNext" class="btn-nav p-next" onclick="changePage(1)"
                        @(ViewBag.HasNext ? "" : "disabled")>
                    Next <i class="fas fa-arrow-right ms-2"></i>
                </button>
            </div>
       </div>

@section Scripts {
    <script>
        let currentSortColumn = "";
        let currentSortDirection = "";
        let currentPage = 1;

        function loadData() {
            var searchValue = $('#userSearchInput').val();
            var sortOrder = currentSortColumn + currentSortDirection;

            $.ajax({
                url: '@Url.Action("FilterUsers", "Staff")',
                type: 'GET',
                data: {
                    searchString: searchValue,
                    sortOrder: sortOrder,
                    pageNumber: currentPage
                },
                success: function (result) {
                    $('#tableBody').html(result);

                    var meta = $('#pagingMetadata');
                    var hasPrev = meta.data('has-prev');
                    var hasNext = meta.data('has-next');
                    var pageIndex = meta.data('page-index');
                    var totalPages = meta.data('total-pages');
                    var totalRecords = meta.data('total-records');

                    $('#totalRecordsBadge').text(totalRecords + ' Records');
                $('#pageInfo').html('Page <span class="fw-bold text-dark">' + pageIndex +
                                        '</span> of <span class="fw-bold text-dark">' +
                                        (totalPages === 0 ? 1 : totalPages) + '</span>');   

                    $('#btnPrev').prop('disabled', !hasPrev);
                    $('#btnNext').prop('disabled', !hasNext);
                },
                error: function () {
                    console.log('Error fetching data.');
                }
            });
        }

        function changePage(direction) {
            currentPage += direction;
            loadData();
        }

        function handleSearch(searchValue) {
            var clearBtn = document.getElementById('clearSearchBtn');
            clearBtn.style.display = (searchValue.length > 0) ? 'block' : 'none';

            currentPage = 1;
            loadData();
        }

        function handleSort(column) {
            $('.custom-table th i').removeClass('fa-sort-up fa-sort-down').addClass('fa-sort');

            if (currentSortColumn === column) {
                currentSortDirection = (currentSortDirection === "") ? "_desc" : "";
            } else {
                currentSortColumn = column;
                currentSortDirection = "";
            }

            var iconId = '#icon_' + column;
            $(iconId).removeClass('fa-sort');
            if (currentSortDirection === "_desc") $(iconId).addClass('fa-sort-down');
            else $(iconId).addClass('fa-sort-up');

            currentPage = 1;
            loadData();
        }

        function clearSearch() {
            var input = document.getElementById('userSearchInput');
            input.value = "";
            document.getElementById('clearSearchBtn').style.display = 'none';
            handleSearch("");
        }

        function toggleStatus(userId, btnElement) {
            if(!confirm("Are you sure you want to change this user's status?")) return;

            $.ajax({
                url: '@Url.Action("ToggleUserStatus", "Admin")',
                type: 'POST',
                data: { id: userId },
                success: function (response) {
                    if (response.success) {
                        loadData();
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert("Error communicating with server.");
                }
            });
        }

        $(document).ready(function() {
            loadData();
        });
    </script>
}