@model BookInsertVM;

@{
    ViewBag.Title = "Insert";
}

@section head {
    <link rel="stylesheet" href="/css/catalogue.css" asp-append-version="true" />
}

@* TODO: Add dynamic preview of what users see when inserting book. *@

<section class="book-preview"></section>

<section class="book-insert">
    <form class="book-insert__form" method="post">
        <div asp-validation-summary="ModelOnly"></div>

        <div class=book-insert__field-item>
            <label class="book-insert__label" asp-for="Title"></label>
            <input class="book-insert__input" asp-for="Title" data-trim autofocus />
            <span class="book-insert__error" asp-validation-for="Title"></span>
        </div>
        <div class=book-insert__field-item>
            <label class="book-insert__label" asp-for="Description"></label>
            <textarea class="book-insert__input" asp-for="Description" data-trim></textarea>
            <span class="book-insert__error" asp-validation-for="Description"></span>
        </div>
        <div class=book-insert__field-item>
            <label class="book-insert__label" asp-for="ISBN"></label>
            <input class="book-insert__input" asp-for="ISBN" data-trim />
            <span class="book-insert__error" asp-validation-for="ISBN"></span>
        </div>
        <div class=book-insert__field-item>
            <label class="book-insert__label" asp-for="PublicationYear"></label>
            <input class="book-insert__input" type="number" step="1" value="@DateTime.Now.Year" asp-for="PublicationYear" data-trim />
            <span class="book-insert__error" asp-validation-for="PublicationYear"></span>
        </div>

        <section class="book-insert__button-container">
            <button class="book-insert__button book-insert__button--reset" type="reset">Reset</button>
            <button class="book-insert__button book-insert__button--submit" type="submit">Submit</button>
        </section>
    </form>
</section>

@section foot {
    <script src="/js/catalogue.js" asp-append-version="true"></script>
}
